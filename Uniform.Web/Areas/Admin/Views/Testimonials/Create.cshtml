@model UniformPro.Web.ViewModels.TestimonialViewModel
@{
    ViewData["Title"] = "إضافة تقييم";
}
<style>
    .validation-summary-valid { display: none; }
</style>

<div class="max-w-4xl mx-auto">
    <form asp-action="Create" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="text-red-500 mb-4 font-bold border border-red-200 bg-red-50 p-3 rounded-md"></div>
        
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
            <div class="flex flex-col md:flex-row items-start md:items-center gap-4 w-full md:w-auto">
                <h2 class="text-xl font-bold text-gray-800">إضافة رأي عميل جديد</h2>
                
                <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
                    <div class="flex items-center bg-white px-3 py-1.5 rounded-md shadow-sm border border-gray-200 flex-1 md:flex-none">
                        <input asp-for="IsActive" class="w-4 h-4 text-primary border-gray-300 rounded focus:ring-primary">
                        <label asp-for="IsActive" class="mr-2 text-sm font-bold text-gray-700 select-none cursor-pointer">تفعيل</label>
                    </div>
                    <div class="flex items-center bg-white px-3 py-1.5 rounded-md shadow-sm border border-gray-200 flex-1 md:flex-none">
                        <input asp-for="ShowOnHome" class="w-4 h-4 text-primary border-gray-300 rounded focus:ring-primary">
                        <label asp-for="ShowOnHome" class="mr-2 text-sm font-bold text-gray-700 select-none cursor-pointer">عرض</label>
                    </div>
                </div>
            </div>
            <a asp-action="Index" class="text-gray-500 hover:text-gray-700 self-end md:self-auto">إلغاء</a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 h-fit">
                <h3 class="font-bold text-gray-800 mb-4 border-b pb-2">بيانات العميل</h3>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        اسم العميل
                        <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="ClientName" autocomplete="off" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary">
                    <span asp-validation-for="ClientName" class="text-red-500 text-xs"></span>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">المسمى الوظيفي / الشركة</label>
                    <input asp-for="Position" autocomplete="off" placeholder="مثال: مدير مشتريات فندق..." class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary">
                    <span asp-validation-for="Position" class="text-red-500 text-xs"></span>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">المشروع المرتبط (اختياري)</label>
                    <select asp-for="PortfolioId" asp-items="ViewBag.Portfolios" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary">
                        <option value="">-- اختر مشروع --</option>
                    </select>
                </div>

                <div class="mb-4 grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">اسم المنتج (عربي)</label>
                        <input asp-for="ProductNameAr" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">اسم المنتج (إنجليزي)</label>
                        <input asp-for="ProductNameEn" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary">
                    </div>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        رأي العميل (نص)
                        <span class="text-red-500">*</span>
                    </label>
                    <textarea asp-for="Feedback" rows="4" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary"></textarea>
                    <span asp-validation-for="Feedback" class="text-red-500 text-xs"></span>
                </div>
            </div>

            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 h-fit">
                <h3 class="font-bold text-gray-800 mb-4 border-b pb-2">الميديا (Video & Image)</h3>

                <div class="mb-6">
                    <label class="block text-sm font-medium text-gray-700 mb-2">صورة العميل (Thumbnail)</label>
                    <div id="imgPreviewArea" class="hidden mb-2 relative w-20 h-20 rounded-full overflow-hidden border">
                         <img id="imgPreview" src="#" class="w-full h-full object-cover">
                    </div>
                    <div class="flex items-center gap-2">
                         <input type="file" id="ImageFile" name="ImageFile" accept="image/*" onchange="if(validateFileInput(this, ['image'], 5)) previewImage(this, 'imgPreview', 'imgPreviewArea', 'clearImageBtn')"
                           class="block w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-600 hover:file:bg-blue-100" />
                         <button type="button" id="clearImageBtn" onclick="clearFileInput('ImageFile', 'imgPreviewArea', 'clearImageBtn')" class="hidden text-red-500 hover:text-red-700 text-sm" title="إلغاء الصورة"><i class="ph-bold ph-x"></i></button>
                    </div>
                    <p class="text-xs text-gray-500 mt-1 helper-text">يفضل صورة مربعة. الصيغ المدعومة: JPG, PNG, WEBP. الحد الأقصى: 5 ميجابايت.</p>
                </div>

                <!-- Cover Image -->
                <div class="mb-6">
                    <label class="block text-sm font-medium text-gray-700 mb-2">صورة الغلاف (Cover Image)</label>
                    <div id="coverPreviewArea" class="hidden mb-2 relative w-32 aspect-[4/5] rounded-lg overflow-hidden border">
                         <img id="coverPreview" src="#" class="w-full h-full object-cover">
                    </div>
                    <div class="flex items-center gap-2">
                         <input type="file" id="CoverImageFile" name="CoverImageFile" accept="image/*" onchange="if(validateFileInput(this, ['image'], 5)) previewImage(this, 'coverPreview', 'coverPreviewArea', 'clearCoverBtn')"
                           class="block w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-green-50 file:text-green-600 hover:file:bg-green-100" />
                         <button type="button" id="clearCoverBtn" onclick="clearFileInput('CoverImageFile', 'coverPreviewArea', 'clearCoverBtn')" class="hidden text-red-500 hover:text-red-700 text-sm" title="إلغاء الصورة"><i class="ph-bold ph-x"></i></button>
                    </div>
                    <p class="text-xs text-gray-500 mt-1 helper-text">
                        <i class="ph-fill ph-info text-blue-500"></i> صورة للعرض فى كروت العملاء السعداء فى الصفحة الرئيسية يفضل صورة طولية
                    </p>
                </div>

                <div class="border-t my-4"></div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">رفع فيديو (MP4)</label>
                    <div id="videoPreviewArea" class="hidden mb-2 relative w-40 aspect-video rounded-lg overflow-hidden border border-gray-200 bg-black">
                        <video id="videoPreview" class="w-full h-full object-cover" controls></video>
                        <button type="button" onclick="clearVideo()" class="absolute top-1 right-1 bg-red-600 text-white rounded-full w-6 h-6 flex items-center justify-center shadow-md hover:bg-red-700 transition-colors"><i class="ph-bold ph-x text-xs"></i></button>
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="file" id="VideoFile" name="VideoFile" accept="video/*" onchange="if(validateFileInput(this, ['video'], 20)) previewVideo(this)" class="block w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-purple-50 file:text-purple-600 hover:file:bg-purple-100 mb-2" />
                    </div>
                    <p class="text-xs text-gray-500 helper-text">يفضل فيديوهات قصيرة (Reels). الصيغ المدعومة: MP4, MOV. الحد الأقصى: 20 ميجابايت.</p>
                </div>

                <div class="relative flex py-2 items-center">
                    <div class="flex-grow border-t border-gray-200"></div>
                    <span class="flex-shrink-0 mx-4 text-gray-400 text-xs">أو رابط يوتيوب</span>
                    <div class="flex-grow border-t border-gray-200"></div>
                </div>

                <div class="mb-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1">YouTube URL</label>
                    <div class="relative">
                        <i class="ph-fill ph-youtube-logo absolute top-2.5 left-3 text-red-500"></i>
                        <input asp-for="YoutubeUrl" autocomplete="off" class="w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md outline-none focus:border-primary text-sm dir-ltr" style="direction:ltr;">
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-6 flex justify-end gap-3 border-t pt-4">
            <button type="submit" class="px-8 py-2 bg-primary text-white rounded-md hover:bg-green-700 font-medium shadow-sm">حفظ التقييم</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(input, imgId, areaId, btnId) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#' + imgId).attr('src', e.target.result);
                    $('#' + areaId).removeClass('hidden');
                    if(btnId) $('#' + btnId).removeClass('hidden');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function previewVideo(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#videoPreview').attr('src', e.target.result);
                    $('#videoPreviewArea').removeClass('hidden');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function clearFileInput(inputId, previewAreaId, btnId) {
            $('#' + inputId).val(''); 
            if(previewAreaId) {
                $('#' + previewAreaId).addClass('hidden');
            }
            if(btnId) {
                $('#' + btnId).addClass('hidden');
            }
        }

        function clearVideo() {
            $('#VideoFile').val('');
            $('#videoPreviewArea').addClass('hidden');
            $('#videoPreview').attr('src', '');
        }
    </script>
}