@model UniformPro.Web.ViewModels.TestimonialViewModel
@{
    ViewData["Title"] = "إضافة تقييم";
}

<div class="max-w-4xl mx-auto">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-xl font-bold text-gray-800">إضافة رأي عميل جديد</h2>
        <a asp-action="Index" class="text-gray-500 hover:text-gray-700">إلغاء</a>
    </div>

    <form asp-action="Create" enctype="multipart/form-data">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 h-fit">
                <h3 class="font-bold text-gray-800 mb-4 border-b pb-2">بيانات العميل</h3>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">اسم العميل</label>
                    <input asp-for="ClientName" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary">
                    <span asp-validation-for="ClientName" class="text-red-500 text-xs"></span>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">المسمى الوظيفي / الشركة</label>
                    <input asp-for="Position" placeholder="مثال: مدير مشتريات فندق..." class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary">
                    <span asp-validation-for="Position" class="text-red-500 text-xs"></span>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">رأي العميل (نص)</label>
                    <textarea asp-for="Feedback" rows="4" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary"></textarea>
                    <span asp-validation-for="Feedback" class="text-red-500 text-xs"></span>
                </div>

                <div class="flex items-center">
                    <input asp-for="IsActive" type="checkbox" class="w-4 h-4 text-primary rounded border-gray-300 focus:ring-primary">
                    <label asp-for="IsActive" class="mr-2 text-sm text-gray-700">تفعيل وعرض في الموقع</label>
                </div>
            </div>

            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 h-fit">
                <h3 class="font-bold text-gray-800 mb-4 border-b pb-2">الميديا (Video & Image)</h3>

                <div class="mb-6">
                    <label class="block text-sm font-medium text-gray-700 mb-2">صورة العميل (Thumbnail)</label>
                    <div id="imgPreviewArea" class="hidden mb-2 w-20 h-20 rounded-full overflow-hidden border">
                        <img id="imgPreview" src="#" class="w-full h-full object-cover">
                    </div>
                    <input type="file" name="ImageFile" accept="image/*" onchange="previewImage(this)"
                           class="block w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-600 hover:file:bg-blue-100" />
                </div>

                <div class="border-t my-4"></div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">رفع فيديو (MP4)</label>
                    <input type="file" name="VideoFile" accept="video/*" class="block w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-purple-50 file:text-purple-600 hover:file:bg-purple-100 mb-2" />
                    <p class="text-xs text-gray-400">يفضل فيديوهات قصيرة (Reels) لسرعة التحميل</p>
                </div>

                <div class="relative flex py-2 items-center">
                    <div class="flex-grow border-t border-gray-200"></div>
                    <span class="flex-shrink-0 mx-4 text-gray-400 text-xs">أو رابط يوتيوب</span>
                    <div class="flex-grow border-t border-gray-200"></div>
                </div>

                <div class="mb-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1">YouTube URL</label>
                    <div class="relative">
                        <i class="ph-fill ph-youtube-logo absolute top-2.5 left-3 text-red-500"></i>
                        <input asp-for="YoutubeUrl" class="w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md outline-none focus:border-primary text-sm dir-ltr" style="direction:ltr;">
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-6 flex justify-end gap-3 border-t pt-4">
            <button type="submit" class="px-8 py-2 bg-primary text-white rounded-md hover:bg-green-700 font-medium shadow-sm">حفظ التقييم</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#imgPreview').attr('src', e.target.result);
                    $('#imgPreviewArea').removeClass('hidden');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}