
@model UniformPro.Web.ViewModels.TestimonialViewModel
@{
    ViewData["Title"] = "تعديل التقييم";
}
<style>
    .validation-summary-valid { display: none; }
</style>

<div class="max-w-4xl mx-auto">
    <form asp-action="Edit" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="text-red-500 mb-4 font-bold border border-red-200 bg-red-50 p-3 rounded-md"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" name="DeleteClientImage" id="DeleteClientImage" value="false" />
        <input type="hidden" name="DeleteClientVideo" id="DeleteClientVideo" value="false" />
        <input type="hidden" name="DeleteClientCoverImage" id="DeleteClientCoverImage" value="false" />

        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
            <div class="flex flex-col md:flex-row items-start md:items-center gap-4 w-full md:w-auto">
                <h2 class="text-xl font-bold text-gray-800">تعديل التقييم</h2>
                
                <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
                    <div class="flex items-center bg-white px-3 py-1.5 rounded-md shadow-sm border border-gray-200 flex-1 md:flex-none">
                        <input asp-for="IsActive" class="w-4 h-4 text-primary border-gray-300 rounded focus:ring-primary">
                        <label asp-for="IsActive" class="mr-2 text-sm font-bold text-gray-700 select-none cursor-pointer">تفعيل</label>
                    </div>
                    <div class="flex items-center bg-white px-3 py-1.5 rounded-md shadow-sm border border-gray-200 flex-1 md:flex-none">
                        <input asp-for="ShowOnHome" class="w-4 h-4 text-primary border-gray-300 rounded focus:ring-primary">
                        <label asp-for="ShowOnHome" class="mr-2 text-sm font-bold text-gray-700 select-none cursor-pointer">عرض الرئيسية</label>
                    </div>
                </div>
            </div>
            <a asp-action="Index" class="text-gray-500 hover:text-gray-700 self-end md:self-auto">عودة</a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 h-fit">
                <h3 class="font-bold text-gray-800 mb-4 border-b pb-2">بيانات العميل</h3>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        اسم العميل
                        <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="ClientName" autocomplete="off" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary">
                    <span asp-validation-for="ClientName" class="text-red-500 text-xs"></span>
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">المسمى الوظيفي</label>
                    <input asp-for="Position" autocomplete="off" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary">
                    <span asp-validation-for="Position" class="text-red-500 text-xs"></span>
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">المشروع المرتبط</label>
                    <select asp-for="PortfolioId" asp-items="ViewBag.Portfolios" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary">
                        <option value="">-- اختر مشروع --</option>
                    </select>
                </div>

                <div class="mb-4 grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">اسم المنتج (عربي)</label>
                        <input asp-for="ProductNameAr" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">اسم المنتج (إنجليزي)</label>
                        <input asp-for="ProductNameEn" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary">
                    </div>
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        رأي العميل
                        <span class="text-red-500">*</span>
                    </label>
                    <textarea asp-for="Feedback" rows="4" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary"></textarea>
                    <span asp-validation-for="Feedback" class="text-red-500 text-xs"></span>
                </div>
            </div>

            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 h-fit">
                <h3 class="font-bold text-gray-800 mb-4 border-b pb-2">🎥 الميديا</h3>

                <!-- Client Image -->
                <div class="mb-6">
                    <label class="block text-sm font-medium text-gray-700 mb-2">صورة العميل</label>
                    <div class="flex items-start gap-3">
                        @if (!string.IsNullOrEmpty(Model.CurrentImagePath))
                        {
                            <div id="currentImageContainer" class="relative w-24 h-24 rounded-full border-2 border-primary/20 p-1 group">
                                <img src="~/uploads/testimonials/images/@Model.CurrentImagePath" class="w-full h-full rounded-full object-cover">
                                <button type="button" onclick="markMediaForDeletion('image')" 
                                        class="absolute top-0 right-0 bg-red-600 text-white rounded-full w-6 h-6 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity shadow-lg transform hover:scale-110"
                                        title="حذف الصورة">
                                    <i class="ph-bold ph-trash text-xs"></i>
                                </button>
                            </div>
                        }
                        
                        <div class="flex-1">
                            <div id="imgPreviewArea" class="hidden mb-3 relative w-20 h-20 rounded-full overflow-hidden border border-dashed border-gray-300">
                                 <img id="imgPreview" src="#" class="w-full h-full object-cover">
                                 <button type="button" onclick="clearFileInput('ImageFile', 'imgPreviewArea')" class="absolute inset-0 bg-black/40 text-white flex items-center justify-center hover:bg-black/60 transition-colors"><i class="ph-bold ph-x text-2xl"></i></button>
                            </div>
                            <input type="file" id="ImageFile" name="ImageFile" accept="image/*" onchange="if(validateFileInput(this, ['image'], 5)) previewImage(this, 'imgPreview', 'imgPreviewArea')"
                                   class="block w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-primary/10 file:text-primary hover:file:bg-primary/20" />
                            <p class="text-xs text-gray-500 mt-1 helper-text">يفضل صورة مربعة. الحد الأقصى: 5 ميجابايت.</p>
                        </div>
                    </div>
                <!-- Cover Image -->
                <div class="mb-6">
                    <label class="block text-sm font-medium text-gray-700 mb-2">صورة الغلاف (Cover Image)</label>
                    <div class="flex items-start gap-3">
                        @if (!string.IsNullOrEmpty(Model.CurrentCoverImage))
                        {
                            <div id="currentCoverContainer" class="relative w-24 aspect-[4/5] rounded-lg border-2 border-primary/20 bg-gray-50 p-1 group">
                                <img src="~/uploads/testimonials/covers/@Model.CurrentCoverImage" class="w-full h-full rounded object-cover">
                                <button type="button" onclick="markMediaForDeletion('cover')" 
                                        class="absolute top-0 right-0 bg-red-600 text-white rounded-full w-6 h-6 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity shadow-lg transform hover:scale-110"
                                        title="حذف الصورة">
                                    <i class="ph-bold ph-trash text-xs"></i>
                                </button>
                            </div>
                        }
                        
                        <div class="flex-1">
                            <div id="coverPreviewArea" class="hidden mb-3 relative w-32 aspect-[4/5] rounded-lg overflow-hidden border border-dashed border-gray-300">
                                 <img id="coverPreview" src="#" class="w-full h-full object-cover">
                                 <button type="button" onclick="clearFileInput('CoverImageFile', 'coverPreviewArea')" class="absolute inset-0 bg-black/40 text-white flex items-center justify-center hover:bg-black/60 transition-colors"><i class="ph-bold ph-x text-2xl"></i></button>
                            </div>
                            <input type="file" id="CoverImageFile" name="CoverImageFile" accept="image/*" onchange="if(validateFileInput(this, ['image'], 5)) previewImage(this, 'coverPreview', 'coverPreviewArea')"
                                   class="block w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-green-50 file:text-green-600 hover:file:bg-green-100" />
                            <p class="text-xs text-gray-500 mt-1 helper-text">
                                <i class="ph-fill ph-info text-blue-500"></i> خيارى: صورة للعرض فى كروت العملاء السعداء فى الصفحة الرئيسية (يفضل طولي)
                            </p>
                        </div>
                    </div>
                </div>

                <div class="border-t my-6 border-dashed"></div>

                <!-- Video Section -->
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-2">فيديو العميل (ملف)</label>
                    
                    @if (!string.IsNullOrEmpty(Model.CurrentVideoPath))
                    {
                        <div id="currentVideoContainer" class="mb-4 relative w-40 aspect-video rounded-lg overflow-hidden border border-gray-200 group bg-black">
                            <video src="~/uploads/testimonials/videos/@Model.CurrentVideoPath" class="w-full h-full object-cover opacity-80"></video>
                            <div class="absolute inset-0 flex items-center justify-center">
                                <i class="ph-fill ph-play-circle text-white text-3xl opacity-80"></i>
                            </div>
                            <button type="button" onclick="markMediaForDeletion('video')" 
                                    class="absolute top-2 right-2 bg-red-600 text-white rounded-full w-6 h-6 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity shadow-md hover:scale-110"
                                    title="حذف الفيديو">
                                <i class="ph-bold ph-trash text-xs"></i>
                            </button>
                        </div>
                    }

                    <div class="flex-1">
                         <div id="newVideoPreviewArea" class="hidden mb-3 relative w-40 aspect-video rounded-lg overflow-hidden border border-gray-200 bg-black">
                            <video id="newVideoPreview" class="w-full h-full object-cover" controls></video>
                            <button type="button" onclick="clearNewVideo()" class="absolute top-1 right-1 bg-red-600 text-white rounded-full w-6 h-6 flex items-center justify-center shadow-md hover:bg-red-700 transition-colors" title="إلغاء الفيديو"><i class="ph-bold ph-x text-xs"></i></button>
                         </div>

                         <input type="file" id="VideoFile" name="VideoFile" accept="video/*" onchange="if(validateFileInput(this, ['video'], 20)) previewVideo(this)" class="block w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-purple-50 file:text-purple-600 hover:file:bg-purple-100" />
                         <p class="text-xs text-gray-500 mt-1 helper-text">الحد الأقصى للفيديو: 20 ميجابايت.</p>
                    </div>
                </div>

                <div class="relative py-4">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-gray-300"></div>
                    </div>
                    <div class="relative flex justify-center text-sm">
                        <span class="px-2 bg-white text-gray-500">أو</span>
                    </div>
                </div>

                <div class="mb-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1">YouTube URL</label>
                    <div class="relative">
                        <i class="ph-fill ph-youtube-logo absolute top-2.5 left-3 text-red-500 text-lg"></i>
                        <input asp-for="YoutubeUrl" autocomplete="off" placeholder="https://www.youtube.com/watch?v=..." class="w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md outline-none focus:border-primary text-sm dir-ltr text-left" style="direction:ltr;">
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-6 flex justify-end gap-3 border-t pt-4">
            <button type="submit" class="px-8 py-2 bg-primary text-white rounded-md hover:bg-green-700 font-medium shadow-sm flex items-center gap-2">
                <i class="ph-bold ph-check"></i> حفظ التعديلات
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function markMediaForDeletion(type) {
            if (type === 'image') {
                $('#DeleteClientImage').val('true');
                $('#currentImageContainer').fadeOut();
            } else if (type === 'video') {
                $('#DeleteClientVideo').val('true');
                $('#currentVideoContainer').fadeOut();
            } else if (type === 'cover') {
                $('#DeleteClientCoverImage').val('true');
                $('#currentCoverContainer').fadeOut();
            }
        }

        function previewImage(input, imgId, areaId) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#' + imgId).attr('src', e.target.result);
                    $('#' + areaId).removeClass('hidden');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
        
        function previewVideo(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#newVideoPreview').attr('src', e.target.result);
                    $('#newVideoPreviewArea').removeClass('hidden');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function clearFileInput(inputId, previewAreaId) {
            $('#' + inputId).val(''); 
            if(previewAreaId) {
                $('#' + previewAreaId).addClass('hidden');
            }
        }
        
        function clearNewVideo() {
            $('#VideoFile').val('');
            $('#newVideoPreviewArea').addClass('hidden');
            $('#newVideoPreview').attr('src', '');
        }
    </script>
}