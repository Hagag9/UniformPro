@model UniformPro.Web.ViewModels.TestimonialViewModel
@{
    ViewData["Title"] = "تعديل التقييم";
}

<div class="max-w-4xl mx-auto">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-xl font-bold text-gray-800">تعديل التقييم</h2>
        <a asp-action="Index" class="text-gray-500 hover:text-gray-700">عودة</a>
    </div>

    <form asp-action="Edit" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 h-fit">
                <h3 class="font-bold text-gray-800 mb-4 border-b pb-2">بيانات العميل</h3>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">اسم العميل</label>
                    <input asp-for="ClientName" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary">
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">المسمى الوظيفي</label>
                    <input asp-for="Position" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary">
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">رأي العميل</label>
                    <textarea asp-for="Feedback" rows="4" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary"></textarea>
                </div>
                <div class="flex items-center">
                    <input asp-for="IsActive" type="checkbox" class="w-4 h-4 text-primary rounded border-gray-300 focus:ring-primary">
                    <label asp-for="IsActive" class="mr-2 text-sm text-gray-700">تفعيل</label>
                </div>
            </div>

            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 h-fit">
                <h3 class="font-bold text-gray-800 mb-4 border-b pb-2">الميديا</h3>

                <div class="mb-6">
                    <label class="block text-sm font-medium text-gray-700 mb-2">صورة العميل</label>
                    @if (!string.IsNullOrEmpty(Model.CurrentImagePath))
                    {
                        <img src="~/uploads/testimonials/images/@Model.CurrentImagePath" class="w-16 h-16 rounded-full border mb-2 object-cover">
                    }
                    <input type="file" name="ImageFile" accept="image/*" class="block w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-blue-600 hover:file:bg-blue-100" />
                </div>

                <div class="border-t my-4"></div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">تغيير الفيديو</label>
                    @if (!string.IsNullOrEmpty(Model.CurrentVideoPath))
                    {
                        <div class="text-xs text-green-600 mb-2 flex items-center gap-1"><i class="ph-bold ph-check"></i> يوجد فيديو مرفوع حالياً</div>
                    }
                    <input type="file" name="VideoFile" accept="video/*" class="block w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-semibold file:bg-purple-50 file:text-purple-600 hover:file:bg-purple-100" />
                </div>

                <div class="mb-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1">YouTube URL</label>
                    <div class="relative">
                        <i class="ph-fill ph-youtube-logo absolute top-2.5 left-3 text-red-500"></i>
                        <input asp-for="YoutubeUrl" class="w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md outline-none focus:border-primary text-sm dir-ltr" style="direction:ltr;">
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-6 flex justify-end gap-3 border-t pt-4">
            <button type="submit" class="px-8 py-2 bg-primary text-white rounded-md hover:bg-green-700 font-medium shadow-sm">حفظ التعديلات</button>
        </div>
    </form>
</div>