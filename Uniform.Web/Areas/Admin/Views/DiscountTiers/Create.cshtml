@model UniformPro.Core.Entities.DiscountTier
@{
    ViewData["Title"] = "إضافة شريحة خصم";
}

<div class="max-w-4xl mx-auto">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-xl font-bold text-gray-800">إضافة شريحة خصم جديدة</h2>
        <a asp-action="Index" class="text-gray-500 hover:text-gray-700">إلغاء</a>
    </div>

    <div class="bg-white p-6 md:p-8 rounded-lg shadow-sm border border-gray-200">
        <form asp-action="Create">
            <div class="space-y-6">
                
                <!-- الاسم بالعربي والإنجليزي -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="NameAr" class="block text-sm font-medium text-gray-700 mb-1">اسم الشريحة (عربي) <span class="text-red-500">*</span></label>
                        <input asp-for="NameAr" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary focus:ring-1 focus:ring-primary" placeholder="مثال: الشريحة البرونزية">
                        <span asp-validation-for="NameAr" class="text-red-500 text-xs"></span>
                    </div>
                    <div>
                        <label asp-for="NameEn" class="block text-sm font-medium text-gray-700 mb-1">Tier Name (English) <span class="text-red-500">*</span></label>
                        <input asp-for="NameEn" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary focus:ring-1 focus:ring-primary text-left" style="direction: ltr;" placeholder="e.g. Bronze Tier">
                        <span asp-validation-for="NameEn" class="text-red-500 text-xs"></span>
                    </div>
                </div>

                <!-- نسبة الخصم واللون -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="DiscountPercentage" class="block text-sm font-medium text-gray-700 mb-1">نسبة الخصم (%) <span class="text-red-500">*</span></label>
                        <div class="relative">
                            <input asp-for="DiscountPercentage" type="number" step="0.01" min="0" max="100" class="w-full border border-gray-300 rounded-md px-3 py-2 pl-10 outline-none focus:border-primary focus:ring-1 focus:ring-primary" placeholder="15">
                            <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">%</span>
                        </div>
                        <span asp-validation-for="DiscountPercentage" class="text-red-500 text-xs"></span>
                    </div>
                    <div>
                        <label asp-for="ColorCode" class="block text-sm font-medium text-gray-700 mb-1">لون الشريحة <span class="text-red-500">*</span></label>
                        <div class="flex gap-2">
                            <input asp-for="ColorCode" type="color" id="colorPicker" class="w-14 h-10 p-1 border border-gray-300 rounded-md cursor-pointer">
                            <input type="text" id="colorCodeText" class="flex-1 border border-gray-300 rounded-md px-3 py-2 text-left outline-none focus:border-primary focus:ring-1 focus:ring-primary" style="direction: ltr;" readonly>
                        </div>
                        <span asp-validation-for="ColorCode" class="text-red-500 text-xs"></span>
                    </div>
                </div>

                <!-- الحد الأدنى والأقصى -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="MinQuantity" class="block text-sm font-medium text-gray-700 mb-1">الحد الأدنى للقطع <span class="text-red-500">*</span></label>
                        <input asp-for="MinQuantity" type="number" min="1" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary focus:ring-1 focus:ring-primary" placeholder="50">
                        <span asp-validation-for="MinQuantity" class="text-red-500 text-xs"></span>
                    </div>
                    <div>
                        <label asp-for="MaxQuantity" class="block text-sm font-medium text-gray-700 mb-1">الحد الأقصى للقطع <span class="text-gray-400 text-xs">(اتركه فارغ للشريحة المفتوحة)</span></label>
                        <input asp-for="MaxQuantity" type="number" min="1" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary focus:ring-1 focus:ring-primary" placeholder="100">
                        <span asp-validation-for="MaxQuantity" class="text-red-500 text-xs"></span>
                    </div>
                </div>

                <!-- ترتيب الظهور والحالة -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="DisplayOrder" class="block text-sm font-medium text-gray-700 mb-1">ترتيب الظهور</label>
                        <input asp-for="DisplayOrder" type="number" min="0" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary focus:ring-1 focus:ring-primary" placeholder="0">
                        <p class="text-xs text-gray-400 mt-1">الأصغر يظهر أولاً</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">حالة الشريحة</label>
                        <label class="flex items-center gap-3 mt-2 cursor-pointer">
                            <input asp-for="IsActive" type="checkbox" class="w-5 h-5 rounded border-gray-300 text-primary focus:ring-primary">
                            <span class="text-gray-700">تفعيل الشريحة</span>
                        </label>
                    </div>
                </div>

                <!-- النص الترويجي -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="PromoTextAr" class="block text-sm font-medium text-gray-700 mb-1">نص ترويجي (عربي)</label>
                        <input asp-for="PromoTextAr" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary focus:ring-1 focus:ring-primary" placeholder="مثال: الأكثر طلباً">
                    </div>
                    <div>
                        <label asp-for="PromoTextEn" class="block text-sm font-medium text-gray-700 mb-1">Promo Text (English)</label>
                        <input asp-for="PromoTextEn" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary focus:ring-1 focus:ring-primary text-left" style="direction: ltr;" placeholder="e.g. Most Popular">
                    </div>
                </div>

                <!-- المزايا -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="BenefitsAr" class="block text-sm font-medium text-gray-700 mb-1">مزايا الشريحة (عربي)</label>
                        <textarea asp-for="BenefitsAr" rows="4" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary focus:ring-1 focus:ring-primary" placeholder="شحن مجاني&#10;هدية مجانية&#10;أولوية في التنفيذ"></textarea>
                        <p class="text-xs text-gray-400 mt-1">كل ميزة في سطر جديد</p>
                    </div>
                    <div>
                        <label asp-for="BenefitsEn" class="block text-sm font-medium text-gray-700 mb-1">Benefits (English)</label>
                        <textarea asp-for="BenefitsEn" rows="4" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary focus:ring-1 focus:ring-primary text-left" style="direction: ltr;" placeholder="Free Shipping&#10;Free Gift&#10;Priority Processing"></textarea>
                        <p class="text-xs text-gray-400 mt-1">Each benefit on a new line</p>
                    </div>
                </div>

                <!-- زر الحفظ -->
                <div class="pt-4 flex flex-col-reverse md:flex-row justify-end gap-3">
                    <a asp-action="Index" class="px-6 py-2 bg-gray-100 text-gray-700 rounded-md hover:bg-gray-200 font-medium transition-colors text-center">
                        إلغاء
                    </a>
                    <button type="submit" class="px-6 py-2 bg-primary text-white rounded-md hover:bg-green-700 font-medium shadow-sm transition-colors">
                        حفظ الشريحة
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // تزامن Color Picker مع حقل النص
        const colorPicker = document.getElementById('colorPicker');
        const colorCodeText = document.getElementById('colorCodeText');
        
        // تحديث عند التحميل
        colorCodeText.value = colorPicker.value;
        
        // تحديث عند تغيير اللون
        colorPicker.addEventListener('input', function() {
            colorCodeText.value = this.value;
        });
    </script>
}
