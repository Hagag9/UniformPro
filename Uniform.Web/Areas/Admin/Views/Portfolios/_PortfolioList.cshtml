@using UniformPro.Web.Helpers
@model PaginatedList<UniformPro.Core.Entities.Portfolio>

<div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
    @if (Model.Count == 0)
    {
        <div class="text-center py-12">
            <i class="ph ph-magnifying-glass text-4xl text-gray-300 mb-3 block"></i>
            <p class="text-gray-500">لا توجد مشاريع تطابق بحثك</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-right">
                <thead class="bg-gray-50 text-gray-700 border-b custom-font font-bold">
                    <tr>
                        <th class="px-4 py-3 w-20">الصورة</th>
                        <th class="px-4 py-3">اسم العميل</th>
                        <th class="px-4 py-3 w-24">الترتيب</th>
                        <th class="px-4 py-3 w-24">عرض في الرئيسية</th>
                        <th class="px-4 py-3 w-32 text-center">الإجراءات</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-gray-50 transition-colors group">
                            <td class="px-4 py-3">
                                <div class="w-12 h-12 rounded-md overflow-hidden bg-gray-100 border">
                                    @if (!string.IsNullOrEmpty(item.CoverImagePath))
                                    {
                                        <img src="~/uploads/portfolios/covers/@item.CoverImagePath" alt="Cover" class="w-full h-full object-cover">
                                    }
                                    else
                                    {
                                        <div class="flex items-center justify-center h-full text-gray-400"><i class="ph ph-image text-xl"></i></div>
                                    }
                                </div>
                            </td>
                            <td class="px-4 py-3 font-medium text-gray-900">@item.ClientNameAr</td>
                            <td class="px-4 py-3">
                                <span class="text-gray-600 font-mono">@item.DisplayOrder</span>
                            </td>
                            <td class="px-4 py-3">
                                @if (item.ShowOnHome)
                                {
                                    <span class="inline-flex items-center gap-1 rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">
                                        <i class="ph-bold ph-check"></i> نعم
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 rounded-full bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10">
                                        لا
                                    </span>
                                }
                            </td>
                            <td class="px-4 py-3 text-center">
                                <div class="flex items-center justify-center gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="text-blue-600 hover:text-blue-800 bg-blue-50 hover:bg-blue-100 w-8 h-8 flex items-center justify-center rounded-lg transition-colors" title="تعديل">
                                        <i class="ph-bold ph-pencil-simple"></i>
                                    </a>
                                    <button type="button" onclick="confirmDelete(@item.Id)" class="text-red-600 hover:text-red-800 bg-red-50 hover:bg-red-100 w-8 h-8 flex items-center justify-center rounded-lg transition-colors" title="حذف">
                                        <i class="ph-bold ph-trash"></i>
                                    </button>
                                </div>
                                <form id="delete-form-@item.Id" asp-action="Delete" asp-route-id="@item.Id" method="post" class="hidden"></form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (Model.TotalPages > 1)
    {
        <div class="flex justify-between items-center p-4 border-t bg-gray-50">
            <span class="text-sm text-gray-500">
                صفحة @Model.PageIndex من @Model.TotalPages
            </span>
            <div class="flex gap-2">
                <a href="javascript:void(0)" onclick="loadPage(@(Model.PageIndex - 1))"
                   class="px-3 py-1 border border-gray-300 rounded-md text-sm bg-white hover:bg-gray-50 text-gray-700 @(!Model.HasPreviousPage ? "pointer-events-none opacity-50" : "")">
                    السابق
                </a>

                <a href="javascript:void(0)" onclick="loadPage(@(Model.PageIndex + 1))"
                   class="px-3 py-1 border border-gray-300 rounded-md text-sm bg-white hover:bg-gray-50 text-gray-700 @(!Model.HasNextPage ? "pointer-events-none opacity-50" : "")">
                    التالي
                </a>
            </div>
        </div>
    }
</div>