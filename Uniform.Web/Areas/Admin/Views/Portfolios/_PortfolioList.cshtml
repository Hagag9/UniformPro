@using UniformPro.Web.Helpers
@model PaginatedList<UniformPro.Core.Entities.Portfolio>

<div id="portfolioContainer">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-6">
        @if (Model.Count == 0)
        {
            <div class="col-span-full text-center py-12 bg-white rounded-lg border border-dashed border-gray-300">
                <i class="ph ph-magnifying-glass text-4xl text-gray-300 mb-3 block"></i>
                <p class="text-gray-500">لا توجد مشاريع تطابق بحثك</p>
            </div>
        }

        @foreach (var item in Model)
        {
            <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden group hover:shadow-md transition-shadow">
                <div class="relative h-48 bg-gray-100">
                    @if (!string.IsNullOrEmpty(item.CoverImagePath))
                    {
                        <img src="~/uploads/portfolios/covers/@item.CoverImagePath" alt="Cover" class="w-full h-full object-cover">
                    }
                    else
                    {
                        <div class="flex items-center justify-center h-full text-gray-400"><i class="ph ph-image text-4xl"></i></div>
                    }

                    <div class="absolute inset-0 bg-black/40 flex items-center justify-center gap-3 opacity-0 group-hover:opacity-100 transition-opacity">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="bg-white text-gray-800 p-2 rounded-full hover:text-primary transition-colors" title="تعديل">
                            <i class="ph-bold ph-pencil-simple text-lg"></i>
                        </a>
                        <button type="button" onclick="confirmDelete(@item.Id, this)" class="bg-white text-red-600 p-2 rounded-full hover:bg-red-50 transition-colors" title="حذف">
                            <i class="ph-bold ph-trash text-lg"></i>
                        </button>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="hidden"></form>
                    </div>

                    <div class="absolute top-3 right-3">
                        @if (item.ShowOnHome)
                        {
                            <span class="bg-green-500 text-white text-xs font-bold px-2 py-1 rounded shadow-sm">رئيسية</span>
                        }
                    </div>
                </div>

                <div class="p-4">
                    <div class="flex justify-between items-start mb-2">
                        <h3 class="font-bold text-lg text-gray-800 line-clamp-1">@item.ClientNameAr</h3>
                        <span class="bg-gray-100 text-gray-600 text-xs px-2 py-1 rounded whitespace-nowrap">@item.Category.NameAr</span>
                    </div>
                    <p class="text-xs text-gray-500 line-clamp-1">@item.ClientNameEn</p>
                </div>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="flex justify-between items-center bg-gray-50/50 p-4 rounded-lg border border-gray-200">
            <span class="text-sm text-gray-500">
                صفحة @Model.PageIndex من @Model.TotalPages
            </span>
            <div class="flex gap-2">
                <a href="@Url.Action("Index", new { pageNumber = Model.PageIndex - 1, searchString = ViewData["CurrentFilter"] })"
                   class="px-3 py-1 border border-gray-300 rounded-md text-sm bg-white hover:bg-gray-50 text-gray-700 @(!Model.HasPreviousPage ? "pointer-events-none opacity-50" : "")">
                    السابق
                </a>

                <a href="@Url.Action("Index", new { pageNumber = Model.PageIndex + 1, searchString = ViewData["CurrentFilter"] })"
                   class="px-3 py-1 border border-gray-300 rounded-md text-sm bg-white hover:bg-gray-50 text-gray-700 @(!Model.HasNextPage ? "pointer-events-none opacity-50" : "")">
                    التالي
                </a>
            </div>
        </div>
    }
</div>