@model UniformPro.Web.ViewModels.PortfolioViewModel
@{
    ViewData["Title"] = "إضافة مشروع جديد";
}

<div class="max-w-6xl mx-auto">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-xl font-bold text-gray-800">إضافة مشروع جديد</h2>
        <a asp-action="Index" class="text-gray-500 hover:text-gray-700">إلغاء</a>
    </div>

    <form asp-action="Create" enctype="multipart/form-data">

        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 mb-6">
            <h3 class="font-bold text-gray-800 mb-4 border-b pb-2">💼 تفاصيل المشروع</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">اسم العميل (عربي)</label>
                    <input asp-for="ClientNameAr" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary">
                    <span asp-validation-for="ClientNameAr" class="text-red-500 text-xs"></span>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Client Name (En)</label>
                    <input asp-for="ClientNameEn" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary dir-ltr" style="direction:ltr;">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">القطاع</label>
                    <select asp-for="CategoryId" class="w-full border border-gray-300 rounded-md px-3 py-2 bg-white" asp-items="ViewBag.CategoryId">
                        <option value="">-- اختر --</option>
                    </select>
                </div>
                <div class="flex items-center pt-6">
                    <input asp-for="ShowOnHome" type="checkbox" class="w-5 h-5 text-primary border-gray-300 rounded focus:ring-primary">
                    <label asp-for="ShowOnHome" class="mr-2 text-sm font-medium text-gray-700">عرض في الصفحة الرئيسية؟</label>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">وصف المشروع</label>
                    <textarea asp-for="DescriptionAr" class="richtext"></textarea>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Description (En)</label>
                    <textarea asp-for="DescriptionEn" class="richtext" style="direction:ltr;"></textarea>
                </div>
            </div>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 mb-6">
            <h3 class="font-bold text-gray-800 mb-4 border-b pb-2">🎥 الوسائط والميديا</h3>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="md:col-span-1">
                    <label class="block text-sm font-medium text-gray-700 mb-2">صورة الغلاف (Cover)</label>
                    <div id="coverPreviewArea" class="hidden mb-3 relative w-full h-48 border rounded-lg overflow-hidden">
                        <img id="coverImg" src="#" class="w-full h-full object-cover">
                        <button type="button" onclick="clearCover()" class="absolute top-2 right-2 bg-red-600 text-white rounded-full p-1"><i class="ph-bold ph-x text-xs"></i></button>
                    </div>
                    <input type="file" name="coverImageFile" id="coverInput" accept="image/*" onchange="previewCover(this)"
                           class="block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-purple-50 file:text-purple-600 hover:file:bg-purple-100" />
                </div>

                <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-2">رفع ملفات (صور أو فيديو)</label>

                    <div id="mediaPreviewGrid" class="grid grid-cols-4 gap-3 mb-3"></div>

                    <input type="file" name="mediaFiles" id="mediaInput" multiple accept="image/*,video/*"
                           class="block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-purple-50 file:text-purple-600 hover:file:bg-purple-100" />

                    <div class="mt-6 border-t pt-4">
                        <label class="block text-sm font-medium text-gray-700 mb-2">روابط يوتيوب</label>
                        <div id="youtube-container" class="space-y-2 mb-2">
                            <input type="text" name="youtubeUrls" placeholder="https://youtube.com/..." class="w-full border border-gray-300 rounded-md px-3 py-2 text-xs dir-ltr" style="direction:ltr;">
                        </div>
                        <button type="button" onclick="addYoutubeInput()" class="text-xs text-primary hover:underline flex items-center gap-1"><i class="ph-bold ph-plus"></i> رابط آخر</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 mt-6">
            <h3 class="font-bold text-gray-800 mb-4 border-b pb-2 flex items-center gap-2">
                <i class="ph-fill ph-google-logo text-blue-500"></i> إعدادات السيو (SEO)
                <span class="text-xs font-normal text-gray-500 mr-2">(اختياري - يساعد في الظهور على جوجل)</span>
            </h3>

            <div class="grid grid-cols-1 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">وصف الصفحة (Meta Description)</label>
                    <textarea asp-for="MetaDescription" rows="2" placeholder="اكتب وصفاً مختصراً وجذاباً يظهر في نتائج البحث..." class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary text-sm"></textarea>
                    <p class="text-xs text-gray-400 mt-1">يفضل ألا يزيد عن 160 حرفاً.</p>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">الكلمات المفتاحية (Keywords)</label>
                    <input asp-for="MetaKeywords" placeholder="مثال: يونيفورم مطاعم، ملابس طبية، زي موحد..." class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary text-sm">
                    <p class="text-xs text-gray-400 mt-1">افصل بين الكلمات بفاصلة.</p>
                </div>
            </div>
        </div>
        <div class="flex justify-end gap-3 pt-4 border-t">
            <button type="submit" class="px-8 py-2.5 bg-primary text-white rounded-md hover:bg-green-700 font-medium shadow-sm">حفظ المشروع</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // === Cover Preview ===
        function previewCover(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) { $('#coverImg').attr('src', e.target.result); $('#coverPreviewArea').removeClass('hidden'); }
                reader.readAsDataURL(input.files[0]);
            }
        }
        function clearCover() { $('#coverInput').val(''); $('#coverPreviewArea').addClass('hidden'); }

        // === Media Files Preview (With Video Support) ===
        let mediaFilesDT = new DataTransfer();
        $('#mediaInput').on('change', function(e) {
            for (let i = 0; i < this.files.length; i++) mediaFilesDT.items.add(this.files[i]);
            this.files = mediaFilesDT.files;
            renderMediaPreview();
        });

        function renderMediaPreview() {
            const container = $('#mediaPreviewGrid'); container.empty();
            Array.from(mediaFilesDT.files).forEach((file, index) => {
                const isVideo = file.type.startsWith('video');
                const reader = new FileReader();
                reader.onload = function(e) {
                    let content = isVideo
                        ? `<video src="${e.target.result}" class="w-full h-full object-cover bg-black"></video><i class="ph-fill ph-play-circle absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 text-white text-2xl opacity-80"></i>`
                        : `<img src="${e.target.result}" class="w-full h-full object-cover">`;

                    const html = `
                        <div class="relative h-24 border rounded overflow-hidden group shadow-sm bg-gray-100">
                            ${content}
                            <button type="button" onclick="removeMediaFile(${index})" class="absolute top-1 right-1 bg-red-600 text-white rounded-full w-5 h-5 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity"><i class="ph-bold ph-x text-xs"></i></button>
                        </div>`;
                    container.append(html);
                }
                reader.readAsDataURL(file);
            });
        }
        function removeMediaFile(index) {
            const dt = new DataTransfer();
            const { files } = mediaFilesDT;
            for (let i = 0; i < files.length; i++) if (i !== index) dt.items.add(files[i]);
            mediaFilesDT = dt;
            document.getElementById('mediaInput').files = dt.files;
            renderMediaPreview();
        }

        // === YouTube ===
        function addYoutubeInput() {
            var html = `<div class="relative"><input type="text" name="youtubeUrls" placeholder="Link..." class="w-full border border-gray-300 rounded-md px-3 py-2 text-xs dir-ltr" style="direction:ltr;"><button type="button" onclick="this.parentElement.remove()" class="absolute top-2 right-2 text-red-500 hover:text-red-700"><i class="ph-bold ph-x"></i></button></div>`;
            $('#youtube-container').append(html);
        }
    </script>
}