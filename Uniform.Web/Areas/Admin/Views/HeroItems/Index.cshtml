@model IEnumerable<UniformPro.Core.Entities.HeroItem>
@{ ViewData["Title"] = "سلايدر الرئيسية"; }

<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
    <div>
        <h2 class="text-xl font-bold text-gray-800">سلايدر الصفحة الرئيسية</h2>
        <p class="text-sm text-gray-500 mt-1">
            <i class="ph-bold ph-hand-grabbing"></i> يمكنك سحب وإفلات الصفوف لترتيب الصور
        </p>
    </div>
    <a asp-action="Create" class="w-full md:w-auto bg-primary hover:bg-green-700 text-white px-4 py-2 rounded-md font-medium shadow-sm flex items-center justify-center gap-2 transition-colors">
        <i class="ph-bold ph-plus"></i> إضافة شريحة
    </a>
</div>

<!-- Desktop View: Table -->
<div class="hidden md:block bg-white rounded-lg shadow-sm border border-gray-200 overflow-x-auto">
    <table class="w-full text-right min-w-[600px]">
        <thead class="bg-gray-50 text-gray-500 text-xs uppercase border-b border-gray-200">
            <tr>
                <th class="w-10"></th> <th class="px-6 py-3">الصورة</th>
                <th class="px-6 py-3">العنوان</th>
                <th class="px-6 py-3">الحالة</th>
                <th class="px-6 py-3">الترتيب الحالي</th>
                <th class="px-6 py-3 text-left">إجراءات</th>
            </tr>
        </thead>
        <tbody id="heroTableBody" class="divide-y divide-gray-100">
            @foreach (var item in Model)
            {
                <tr data-id="@item.Id" class="hover:bg-gray-50 transition-colors bg-white">
                    <td class="px-4 py-4 text-center cursor-move text-gray-400 hover:text-gray-600 handle">
                        <i class="ph-bold ph-dots-six-vertical text-xl"></i>
                    </td>
                    <td class="px-6 py-4">
                        <img src="~/uploads/hero/@item.ImagePath" class="h-16 w-32 object-cover rounded border border-gray-200 zoomable cursor-pointer">
                    </td>
                    <td class="px-6 py-4">
                        <div class="font-bold text-gray-800">@item.TitleAr</div>
                        <div class="text-xs text-gray-500">@item.TitleEn</div>
                    </td>
                    <td class="px-6 py-4">
                        @if(item.IsActive)
                        {
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                <span class="w-1.5 h-1.5 mr-1 bg-green-600 rounded-full"></span> مفعل
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                <span class="w-1.5 h-1.5 mr-1 bg-red-600 rounded-full"></span> غير مفعل
                            </span>
                        }
                        
                        @if(item.HasOverlay)
                        {
                            <div class="mt-1 flex items-center text-xs text-gray-500" title="يوجد طبقة شفافة">
                                <i class="ph-bold ph-layers text-primary mr-1"></i> Overlay
                            </div>
                        }
                    </td>
                    <td class="px-6 py-4 font-bold text-primary order-badge">
                        @item.DisplayOrder
                    </td>
                    <td class="px-6 py-4 text-left">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="text-blue-500 hover:text-blue-700 bg-blue-50 p-2 rounded transition-colors inline-block ml-2">
                            <i class="ph-bold ph-pencil-simple text-lg"></i>
                        </a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="inline">
                            <button type="button" onclick="confirmDelete(@item.Id, this)" class="text-red-500 hover:text-red-700 bg-red-50 p-2 rounded transition-colors">
                                <i class="ph-bold ph-trash text-lg"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Mobile View: Cards -->
<div id="heroCardsContainer" class="md:hidden space-y-4">
    @foreach (var item in Model)
    {
        <div data-id="@item.Id" class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 relative">
             <!-- Drag Handle -->
            <div class="absolute top-4 left-4 p-2 text-gray-300 hover:text-gray-600 cursor-move handle">
                <i class="ph-bold ph-dots-six-vertical text-2xl"></i>
            </div>

            <div class="flex gap-4 mb-4">
                 <img src="~/uploads/hero/@item.ImagePath" class="h-20 w-20 object-cover rounded border border-gray-200">
                 <div class="flex-1 pr-1">
                     <h3 class="font-bold text-gray-800 mb-1">@item.TitleAr</h3>
                     <p class="text-xs text-gray-500 mb-2">@item.TitleEn</p>
                      
                     <div class="flex flex-wrap gap-2">
                         @if(item.IsActive)
                        {
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                <span class="w-1.5 h-1.5 mr-1 bg-green-600 rounded-full"></span> مفعل
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                <span class="w-1.5 h-1.5 mr-1 bg-red-600 rounded-full"></span> معطل
                            </span>
                        }
                          @if(item.HasOverlay)
                        {
                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                                <i class="ph-bold ph-layers mr-1"></i> Overlay
                            </span>
                        }
                     </div>
                 </div>
            </div>
            
            <div class="flex items-center justify-between pt-3 border-t border-gray-100">
                 <div class="text-xs text-gray-400 font-medium">
                     الترتيب: <span class="order-badge text-gray-800 text-sm font-bold">@item.DisplayOrder</span>
                 </div>
                 <div class="flex items-center gap-2">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="flex-1 text-blue-600 bg-blue-50 hover:bg-blue-100 px-4 py-2 rounded-lg text-sm font-bold transition-colors">
                        <i class="ph-bold ph-pencil-simple"></i> تعديل
                    </a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="inline">
                        <button type="button" onclick="confirmDelete(@item.Id, this)" class="text-red-600 bg-red-50 hover:bg-red-100 px-4 py-2 rounded-lg text-sm font-bold transition-colors">
                            <i class="ph-bold ph-trash"></i>
                        </button>
                    </form>
                 </div>
            </div>
        </div>
    }
</div>


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            
            function initSortable(elId) {
                var el = document.getElementById(elId);
                if (!el) return;

                new Sortable(el, {
                    handle: '.handle', 
                    animation: 150,
                    ghostClass: 'bg-gray-50',
                    onEnd: function (evt) {
                        saveOrder();
                    }
                });
            }

            // Init for both Desktop (Table) and Mobile (Cards)
            initSortable('heroTableBody');
            initSortable('heroCardsContainer');

            function saveOrder() {
                // Determine which view is visible to get the correct order
                // Or simply check which container has items. 
                // Since the DOM elements exist for both, we need to be careful.
                // Actually, Sortable modifies the DOM of the specific container dragged.
                // We should check BOTH containers and sync them? 
                // No, simplifying: Just read the order from the container that triggered the event?
                // Better approach: Read from the container that is currently visible or just valid.
                
                // Let's grab all IDs from the active view. Since HTML is duplicated, we might have an issue if we just save one.
                // Ideally, if I drag in Mobile, I should reload page to see changes in Desktop or update DOM.
                // For now, simpler approach: Get IDs from the container that changed.
                
                // Wait, if I change order in Mobile, the Desktop table remains old order until refresh.
                // That is acceptable for this user requirement.
                
                // We need to know WHICH list to read. Let's send the ID list based on visibility.
                const isMobile = window.getComputedStyle(document.getElementById('heroCardsContainer')).display !== 'none';
                const containerId = isMobile ? 'heroCardsContainer' : 'heroTableBody';
                const selector = isMobile ? '#heroCardsContainer > div' : '#heroTableBody > tr';

                var sortedIds = [];
                document.querySelectorAll(selector).forEach((el, index) => {
                    sortedIds.push(el.getAttribute('data-id'));
                    // Update badge visually
                    const badge = el.querySelector('.order-badge');
                    if(badge) badge.textContent = index + 1;
                });

                $.ajax({
                    url: '/Admin/HeroItems/UpdateOrder',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(sortedIds),
                    success: function() {
                        const Toast = Swal.mixin({
                            toast: true, position: 'top-end', showConfirmButton: false, timer: 2000
                        });
                        Toast.fire({ icon: 'success', title: 'تم تحديث الترتيب' });
                    },
                    error: function() {
                        Swal.fire('خطأ', 'حدث خطأ أثناء حفظ الترتيب', 'error');
                    }
                });
            }
        });
    </script>
}