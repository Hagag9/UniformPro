@model UniformPro.Core.Entities.HeroItem
@{
    ViewData["Title"] = "إضافة شريحة";
}

<div class="max-w-2xl mx-auto">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-xl font-bold text-gray-800">إضافة شريحة جديدة</h2>
        <a asp-action="Index" class="text-gray-500 hover:text-gray-700">إلغاء</a>
    </div>

    <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
        <form asp-action="Create" enctype="multipart/form-data">
            <div class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">العنوان (عربي) - اختياري</label>
                        <input asp-for="TitleAr" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary focus:ring-1 focus:ring-primary">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Title (En) - Optional</label>
                        <input asp-for="TitleEn" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary focus:ring-1 focus:ring-primary dir-ltr" style="direction:ltr;">
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">الوصف (عربي) - اختياري</label>
                        <input asp-for="SubtitleAr" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary focus:ring-1 focus:ring-primary">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Subtitle (En) - Optional</label>
                        <input asp-for="SubtitleEn" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary focus:ring-1 focus:ring-primary dir-ltr" style="direction:ltr;">
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">صورة الديسكتوب (مطلوب)</label>
                    <input type="file" name="desktopImage" accept="image/*" required onchange="validateFileInput(this, ['image'], 5)" class="block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-green-50 file:text-primary hover:file:bg-green-100" />
                    <p class="text-xs text-gray-500 mt-1">يفضل مقاس عرضي (Landscape) مثل 1920x800</p>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">صورة الموبايل (اختياري)</label>
                    <input type="file" name="mobileImage" accept="image/*" onchange="validateFileInput(this, ['image'], 5)" class="block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-green-50 file:text-primary hover:file:bg-green-100" />
                    <p class="text-xs text-gray-500 mt-1">يفضل مقاس طولي (Portrait) للموبايل. إذا تركتها فارغة سيتم اقتصاص صورة الديسكتوب.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">رابط الزر (اختياري)</label>
                        <input asp-for="LinkUrl" placeholder="/Home/Contact" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary dir-ltr" style="direction:ltr;">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">ترتيب الظهور</label>
                        <input asp-for="DisplayOrder" type="number" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary">
                    </div>
                </div>

                <div class="flex items-center gap-6 pt-2">
                    <div class="flex items-center">
                        <input asp-for="IsActive" type="checkbox" class="w-4 h-4 text-green-600 border-gray-300 rounded focus:ring-green-500">
                        <label asp-for="IsActive" class="mr-2 text-sm font-bold text-gray-700 select-none cursor-pointer">تفعيل الشريحة (Active)</label>
                    </div>

                    <div class="flex items-center">
                        <input asp-for="HasOverlay" type="checkbox" class="w-4 h-4 text-primary border-gray-300 rounded focus:ring-primary">
                        <label asp-for="HasOverlay" class="mr-2 text-sm font-bold text-gray-700 select-none cursor-pointer">إضافة طبقة شفافة (Overlay)</label>
                    </div>
                </div>

                <div class="pt-4 flex justify-end">
                    <button type="submit" class="bg-primary hover:bg-green-700 text-white px-6 py-2 rounded-md font-medium shadow-sm transition-colors">حفظ الشريحة</button>
                </div>
            </div>
        </form>
    </div>
</div>