@model UniformPro.Core.Entities.HeroItem
@{
    ViewData["Title"] = "تعديل شريحة";
}

<div class="max-w-2xl mx-auto">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-xl font-bold text-gray-800">تعديل الشريحة</h2>
        <a asp-action="Index" class="text-gray-500 hover:text-gray-700">إلغاء</a>
    </div>

    <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
        <form asp-action="Edit" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ImagePath" />
            <input type="hidden" asp-for="MobileImagePath" />
            <input type="hidden" asp-for="CreatedAt" />
            <input type="hidden" asp-for="IsActive" />
            
            <div class="space-y-4">
                <!-- الصور الحالية -->
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">الديسكتوب الحالية</label>
                        <img src="~/uploads/hero/@Model.ImagePath" class="h-32 w-auto rounded border border-gray-200 object-cover" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">الموبايل الحالية</label>
                        @if(!string.IsNullOrEmpty(Model.MobileImagePath))
                        {
                            <img src="~/uploads/hero/@Model.MobileImagePath" class="h-32 w-auto rounded border border-gray-200 object-cover" />
                        }
                        else
                        {
                            <span class="text-sm text-gray-500">لا توجد صورة مخصصة</span>
                        }
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">العنوان (عربي) - اختياري</label>
                        <input asp-for="TitleAr" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary focus:ring-1 focus:ring-primary">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Title (En) - Optional</label>
                        <input asp-for="TitleEn" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary focus:ring-1 focus:ring-primary dir-ltr" style="direction:ltr;">
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">الوصف (عربي) - اختياري</label>
                        <input asp-for="SubtitleAr" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary focus:ring-1 focus:ring-primary">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Subtitle (En) - Optional</label>
                        <input asp-for="SubtitleEn" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary focus:ring-1 focus:ring-primary dir-ltr" style="direction:ltr;">
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 border-t pt-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">تغيير صورة الديسكتوب</label>
                        <input type="file" name="desktopImage" accept="image/*" onchange="validateFileInput(this, ['image'], 5)" class="block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-green-50 file:text-primary hover:file:bg-green-100" />
                        <p class="text-xs text-gray-500 mt-1">اتركه فارغاً للإبقاء على الحالية</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">تغيير صورة الموبايل</label>
                        <input type="file" name="mobileImage" accept="image/*" onchange="validateFileInput(this, ['image'], 5)" class="block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-green-50 file:text-primary hover:file:bg-green-100" />
                        <p class="text-xs text-gray-500 mt-1">اتركه فارغاً للإبقاء على الحالية</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">رابط الزر (اختياري)</label>
                        <input asp-for="LinkUrl" placeholder="/Products" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary dir-ltr" style="direction:ltr;">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">ترتيب الظهور</label>
                        <input asp-for="DisplayOrder" type="number" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary">
                    </div>
                </div>

                <div class="pt-4 flex justify-end gap-3">
                    <a asp-action="Index" class="border border-gray-300 text-gray-700 px-6 py-2 rounded-md font-medium hover:bg-gray-50 transition-colors">إلغاء</a>
                    <button type="submit" class="bg-primary hover:bg-green-700 text-white px-6 py-2 rounded-md font-medium shadow-sm transition-colors">حفظ التغييرات</button>
                </div>
            </div>
        </form>
    </div>
</div>
