@model UniformPro.Core.Entities.Category
@{
    ViewData["Title"] = "تعديل قطاع";
}

<div class="max-w-2xl mx-auto">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-xl font-bold text-gray-800">تعديل بيانات قطاع</h2>
        <a asp-action="Index" class="text-gray-500 hover:text-gray-700">إلغاء</a>
    </div>

    <div class="bg-white p-8 rounded-lg shadow-sm border border-gray-200">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" />
            <div class="space-y-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">اسم القطاع (عربي)</label>
                    <input asp-for="NameAr" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary focus:ring-1 focus:ring-primary" placeholder="مثال: مطاعم وكافيهات">
                    <span asp-validation-for="NameAr" class="text-red-500 text-xs"></span>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Sector Name (English)</label>
                    <input asp-for="NameEn" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary focus:ring-1 focus:ring-primary text-left" style="direction: ltr;" placeholder="e.g. Restaurants">
                    <span asp-validation-for="NameEn" class="text-red-500 text-xs"></span>
                </div>

                <div class="pt-4 flex justify-end gap-3">
                    <button type="submit" class="px-6 py-2 bg-primary text-white rounded-md hover:bg-green-700 font-medium shadow-sm transition-colors">
                        حفظ التعديلات
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
