@{
    ViewData["Title"] = "خطأ غير متوقع";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="min-h-[70vh] flex flex-col items-center justify-center text-center p-6">
    <div class="bg-red-50 p-6 rounded-full mb-6 animate-pulse">
        <i class="ph-duotone ph-bug text-6xl text-red-500"></i>
    </div>

    <h1 class="text-3xl font-bold text-gray-800 mb-2">حدث خطأ غير متوقع!</h1>
    <p class="text-gray-500 max-w-md mb-8">
        واجه النظام مشكلة أثناء تنفيذ طلبك. تم تسجيل الخطأ وسيتم مراجعته من قبل المطورين.
    </p>

    <div class="flex gap-4">
        <a href="javascript:location.reload()" class="border border-gray-300 hover:bg-gray-50 text-gray-700 px-6 py-2.5 rounded-md font-medium transition-colors">
            إعادة المحاولة
        </a>
        <a asp-controller="Home" asp-action="Index" class="bg-primary hover:bg-green-700 text-white px-6 py-2.5 rounded-md font-bold transition-colors">
            العودة للرئيسية
        </a>
    </div>
</div>