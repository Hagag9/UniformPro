@model UniformPro.Web.ViewModels.ProductViewModel
@{
    ViewData["Title"] = "إضافة منتج جديد";
}

<div class="max-w-6xl mx-auto">
    <form asp-action="Create" enctype="multipart/form-data" id="createProductForm">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
            <div class="flex flex-col md:flex-row items-start md:items-center gap-4 w-full md:w-auto">
                <h2 class="text-xl font-bold text-gray-800">إضافة منتج جديد</h2>
                
                <!-- Moved ShowOnHome Here for consistency -->
                <div class="flex items-center bg-white px-3 py-1.5 rounded-md shadow-sm border border-gray-200 w-full md:w-auto">
                    <input asp-for="ShowOnHome" class="w-4 h-4 text-primary border-gray-300 rounded focus:ring-primary">
                    <label asp-for="ShowOnHome" class="mr-2 text-sm font-bold text-gray-700 select-none cursor-pointer">عرض في الرئيسية</label>
                </div>
            </div>
            <a asp-action="Index" class="text-gray-500 hover:text-gray-700 self-end md:self-auto">إلغاء وعودة</a>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 mb-6">
            <h3 class="font-bold text-gray-800 mb-4 border-b pb-2">📦 بيانات المنتج</h3>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">اسم المنتج (عربي) <span class="text-red-500">*</span></label>
                    <input asp-for="NameAr" autocomplete="off" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary focus:ring-1 focus:ring-primary" placeholder="مثال: يونيفورم شيف">
                    <span asp-validation-for="NameAr" class="text-red-500 text-xs"></span>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Name (English) <span class="text-red-500">*</span></label>
                    <input asp-for="NameEn" autocomplete="off" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary focus:ring-1 focus:ring-primary dir-ltr" style="direction:ltr;">
                    <span asp-validation-for="NameEn" class="text-red-500 text-xs"></span>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">القطاع / القسم <span class="text-red-500">*</span></label>
                    <select asp-for="CategoryId" class="w-full border border-gray-300 rounded-md px-3 py-2 bg-white outline-none focus:border-primary" asp-items="ViewBag.CategoryId">
                        <option value="">-- اختر --</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-red-500 text-xs"></span>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">السعر المبدئي</label>
                    <input asp-for="StartPrice" autocomplete="off" type="number" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">أقل كمية (MOQ)</label>
                    <input asp-for="MinQuantity" autocomplete="off" type="number" value="1" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary">
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">المقاسات المتاحة</label>
                    <input asp-for="AvailableSizes" autocomplete="off" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary" placeholder="S, M, L, XL">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">الخامة (عربي)</label>
                    <input asp-for="MaterialDetailsAr" autocomplete="off" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Material (En)</label>
                    <input asp-for="MaterialDetailsEn" autocomplete="off" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary dir-ltr" style="direction:ltr;">
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">الوصف التفصيلي (عربي)</label>
                    <textarea asp-for="DescriptionAr" class="richtext"></textarea>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Description (English)</label>
                    <textarea asp-for="DescriptionEn" class="richtext" style="direction:ltr;"></textarea>
                </div>
            </div>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 mb-6">
            <h3 class="font-bold text-gray-800 mb-4 border-b pb-2">🖼️ صور المنتج</h3>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">الصورة الرئيسية (الغلاف)</label>

                    <div id="mainImagePreviewArea" class="hidden mb-3 relative w-48 h-48 border rounded-lg overflow-hidden group">
                        <img id="mainImageImg" src="#" class="w-full h-full object-cover" />
                        <button type="button" onclick="clearMainImage()" class="absolute top-2 right-2 bg-red-600 text-white rounded-full p-1 shadow-md hover:bg-red-700 transition-colors">
                            <i class="ph-bold ph-x"></i>
                        </button>
                    </div>

                    <input type="file" name="mainImageFile" id="mainImageInput" accept="image/*" onchange="if(validateFileInput(this, ['image'], 5)) previewMainImage(this)"                           class="block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-green-50 file:text-primary hover:file:bg-green-100" />
                    <p class="text-xs text-gray-500 mt-1 helper-text">الصيغ المدعومة: JPG, PNG, WEBP. الحد الأقصى: 5 ميجابايت.</p>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">معرض الصور الإضافية</label>

                    <div id="galleryPreviewGrid" class="grid grid-cols-4 gap-3 mb-3"></div>

                    <input type="file" name="galleryFiles" id="galleryInput" multiple accept="image/*" onchange="validateFileInput(this, ['image'], 5)"
                           class="block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-gray-50 file:text-gray-700 hover:file:bg-gray-100" />
                    <p class="text-xs text-gray-500 mt-1 helper-text">يمكنك اختيار أكثر من صورة. الصيغ المدعومة: JPG, PNG, WEBP.</p>
                </div>
            </div>
        </div><div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 mt-6">
            <h3 class="font-bold text-gray-800 mb-4 border-b pb-2 flex items-center gap-2">
                <i class="ph-fill ph-google-logo text-blue-500"></i> إعدادات السيو (SEO)
                <span class="text-xs font-normal text-gray-500 mr-2">(اختياري - يساعد في الظهور على جوجل)</span>
            </h3>

            <div class="grid grid-cols-1 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">وصف الصفحة (Meta Description)</label>
                    <textarea asp-for="MetaDescription" rows="2" placeholder="اكتب وصفاً مختصراً وجذاباً يظهر في نتائج البحث..." class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary text-sm"></textarea>
                    <p class="text-xs text-gray-400 mt-1">يفضل ألا يزيد عن 160 حرفاً.</p>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">الكلمات المفتاحية (Keywords)</label>
                    <input asp-for="MetaKeywords" placeholder="مثال: يونيفورم مطاعم، ملابس طبية، زي موحد..." class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary text-sm">
                    <p class="text-xs text-gray-400 mt-1">افصل بين الكلمات بفاصلة.</p>
                </div>
            </div>
        </div>
        <div class="flex justify-end gap-3 pt-4 border-t">
            <a asp-action="Index" class="px-6 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-white bg-white font-medium">إلغاء</a>
            <button type="submit" class="px-8 py-2 bg-primary text-white rounded-md hover:bg-green-700 font-medium shadow-sm">حفظ المنتج</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // === منطق الصورة الرئيسية ===
        function previewMainImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    $('#mainImageImg').attr('src', e.target.result);
                    $('#mainImagePreviewArea').removeClass('hidden');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function clearMainImage() {
            $('#mainImageInput').val('');
            $('#mainImagePreviewArea').addClass('hidden');
        }

        // === منطق معرض الصور (DataTransfer للحذف الفردي) ===
        // نستخدم متغير عام لتخزين الملفات الحالية
        let galleryFilesDT = new DataTransfer();

        $('#galleryInput').on('change', function(e) {
            // نضيف الملفات الجديدة للملفات الموجودة مسبقاً (لو عايز تضيف مش تستبدل)
            // أو نبدأ من جديد لو عايز تستبدل (هنا هنستبدل ونعيد البناء)
            // galleryFilesDT = new DataTransfer(); // uncomment to replace on new selection

            for (let i = 0; i < this.files.length; i++) {
                galleryFilesDT.items.add(this.files[i]);
            }

            // تحديث الـ input بالملفات المجمعة
            this.files = galleryFilesDT.files;

            renderGalleryPreview();
        });

        function renderGalleryPreview() {
            const container = $('#galleryPreviewGrid');
            container.empty();

            Array.from(galleryFilesDT.files).forEach((file, index) => {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const html = `
                        <div class="relative h-24 border rounded overflow-hidden group shadow-sm bg-gray-100">
                            <img src="${e.target.result}" class="w-full h-full object-cover">
                            <button type="button" onclick="removeGalleryFile(${index})"
                                    class="absolute top-1 right-1 bg-red-600 text-white rounded-full w-5 h-5 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity shadow-md">
                                <i class="ph-bold ph-x text-xs"></i>
                            </button>
                        </div>`;
                    container.append(html);
                }
                reader.readAsDataURL(file);
            });
        }

        function removeGalleryFile(index) {
            const dt = new DataTransfer();
            const input = document.getElementById('galleryInput');
            const { files } = galleryFilesDT;

            for (let i = 0; i < files.length; i++) {
                if (i !== index) dt.items.add(files[i]); // انسخ كله ماعدا المحذوف
            }

            galleryFilesDT = dt; // تحديث المتغير العام
            input.files = dt.files; // تحديث الـ input الفعلي
            renderGalleryPreview(); // إعادة الرسم
        }
    </script>
}