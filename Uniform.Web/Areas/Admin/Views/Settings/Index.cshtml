@model UniformPro.Core.Entities.SiteSettings
@{
    ViewData["Title"] = "إعدادات الموقع";
}

<div class="max-w-4xl mx-auto">
    <div class="flex justify-between items-center mb-6">
        <div>
            <h2 class="text-xl font-bold text-gray-800">إعدادات الموقع العامة</h2>
            <p class="text-sm text-gray-500 mt-1">التحكم في العناوين، أرقام التواصل، وروابط السوشيال ميديا</p>
        </div>
    </div>

    <form asp-action="Update" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="OwnerImage" />
        <input type="hidden" asp-for="LogoPath" />

        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 mb-6">
            <h3 class="font-bold text-gray-800 mb-4 border-b pb-2 flex items-center gap-2">
                <i class="ph-fill ph-globe text-primary"></i> البيانات الأساسية
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">اسم الموقع (عربي)</label>
                    <input asp-for="WebsiteNameAr" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary focus:ring-1 focus:ring-primary">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Website Name (En)</label>
                    <input asp-for="WebsiteNameEn" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary focus:ring-1 focus:ring-primary dir-ltr" style="direction:ltr;">
                </div>
            </div>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 mb-6">
            <h3 class="font-bold text-gray-800 mb-4 border-b pb-2 flex items-center gap-2">
                <i class="ph-fill ph-phone text-primary"></i> التواصل والعنوان
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">رقم الهاتف</label>
                    <input asp-for="PhoneNumber" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary focus:ring-1 focus:ring-primary dir-ltr">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">رقم الهاتف الثاني <span class="text-xs text-gray-400">(اختياري)</span></label>
                    <input asp-for="Phone2Number" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary focus:ring-1 focus:ring-primary dir-ltr">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">رقم الواتساب</label>
                    <input asp-for="WhatsAppNumber" placeholder="بدون علامة +" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary focus:ring-1 focus:ring-primary dir-ltr">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">البريد الإلكتروني</label>
                    <input asp-for="Email" type="email" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary focus:ring-1 focus:ring-primary dir-ltr">
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">العنوان (عربي)</label>
                    <textarea asp-for="AddressAr" rows="2" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary"></textarea>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Address (En)</label>
                    <textarea asp-for="AddressEn" rows="2" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary dir-ltr" style="direction:ltr;"></textarea>
                </div>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">رابط خريطة جوجل (Embed URL أو كود التضمين Iframe)</label>
                <input asp-for="MapLocationUrl" class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary dir-ltr text-xs text-gray-500" style="direction:ltr;">
            </div>
        </div>

        <!-- قسم من نحن -->
        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 mb-6">
            <h3 class="font-bold text-gray-800 mb-4 border-b pb-2 flex items-center gap-2">
                <i class="ph-fill ph-info text-primary"></i> من نحن (About Us)
            </h3>
            
            <!-- لوجو الموقع -->
            <div class="mb-6 border-b pb-6">
                <label class="block text-sm font-medium text-gray-700 mb-2">لوجو الموقع (Logo)</label>
                <div class="flex flex-col md:flex-row items-start gap-4">
                    @if (!string.IsNullOrEmpty(Model.LogoPath))
                    {
                        <div class="shrink-0 bg-gray-50 p-2 rounded-lg border">
                            <img src="~/uploads/sitesettings/@Model.LogoPath" 
                                 alt="Logo" 
                                 class="h-16 w-auto object-contain" />
                        </div>
                    }
                    <div class="flex-1">
                        <input type="file" 
                               name="logoFile" 
                               accept="image/*" onchange="validateFileInput(this, ['image'], 2)" 
                               class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary focus:ring-1 focus:ring-primary file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-primary file:text-white hover:file:bg-green-700" />
                        <p class="text-xs text-gray-400 mt-1">يفضل أن يكون بخلفية شفافة (PNG/WebP). الحد الأقصى: 2 ميجابايت.</p>
                    </div>
                </div>
            </div>

            <!-- صورة المالك -->
            <div class="mb-6">
                <label class="block text-sm font-medium text-gray-700 mb-2">صورة المالك / المؤسس</label>
                <div class="flex flex-col md:flex-row items-start gap-4">
                    @if (!string.IsNullOrEmpty(Model.OwnerImage))
                    {
                        <div class="shrink-0">
                            <img src="~/uploads/sitesettings/@Model.OwnerImage" 
                                 alt="صورة المالك" 
                                 class="w-32 h-32 object-cover rounded-lg border border-gray-200 shadow-sm zoomable cursor-pointer" />
                        </div>
                    }
                    <div class="flex-1">
                        <input type="file" 
                               name="ownerImageFile" 
                               accept="image/*" onchange="validateFileInput(this, ['image'], 5)" 
                               class="w-full border border-gray-300 rounded-md px-3 py-2 outline-none focus:border-primary focus:ring-1 focus:ring-primary file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-primary file:text-white hover:file:bg-green-700" />
                        <p class="text-xs text-gray-400 mt-1">الصيغ المسموحة: JPG, PNG, WebP - سيتم تحويلها تلقائياً لـ WebP</p>
                    </div>
                </div>
            </div>

            <!-- المحتوى العربي -->
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-1">المحتوى (عربي)</label>
                <textarea asp-for="AboutUsAr" class="richtext w-full border border-gray-300 rounded-md">@Model.AboutUsAr</textarea>
            </div>

            <!-- المحتوى الإنجليزي -->
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Content (English)</label>
                <textarea asp-for="AboutUsEn" class="richtext w-full border border-gray-300 rounded-md" dir="ltr" style="direction:ltr;">@Model.AboutUsEn</textarea>
            </div>
        </div>

        <!-- روابط السوشيال ميديا -->
        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 mb-6">
            <h3 class="font-bold text-gray-800 mb-4 border-b pb-2 flex items-center gap-2">
                <i class="ph-fill ph-share-network text-primary"></i> روابط السوشيال ميديا
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                <div class="relative">
                    <i class="ph-fill ph-facebook-logo absolute top-2.5 left-3 text-blue-600 text-lg"></i>
                    <input asp-for="FacebookUrl" placeholder="Facebook URL" class="w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md outline-none focus:border-primary dir-ltr" style="direction:ltr;">
                </div>

                <div class="relative">
                    <i class="ph-fill ph-instagram-logo absolute top-2.5 left-3 text-pink-600 text-lg"></i>
                    <input asp-for="InstagramUrl" placeholder="Instagram URL" class="w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md outline-none focus:border-primary dir-ltr" style="direction:ltr;">
                </div>

                <div class="relative">
                    <i class="ph-fill ph-youtube-logo absolute top-2.5 left-3 text-red-600 text-lg"></i>
                    <input asp-for="YoutubeUrl" placeholder="YouTube Channel URL" class="w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md outline-none focus:border-primary dir-ltr" style="direction:ltr;">
                </div>

                <div class="relative">
                    <i class="ph-fill ph-tiktok-logo absolute top-2.5 left-3 text-black text-lg"></i>
                    <input asp-for="TikTokUrl" placeholder="TikTok Profile URL" class="w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md outline-none focus:border-primary dir-ltr" style="direction:ltr;">
                </div>

            </div>
        </div>

        <div class="flex justify-end pt-2 pb-8">
            <button type="submit" class="bg-primary hover:bg-green-700 text-white px-8 py-3 rounded-md font-bold shadow-md transition-colors flex items-center gap-2">
                <i class="ph-bold ph-check"></i> حفظ التعديلات
            </button>
        </div>
    </form>
</div>