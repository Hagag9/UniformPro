@model UniformPro.Web.ViewModels.ProductIndexViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<UniformPro.Web.Resources.SharedResource> L
@{
    var isArabic = Model.IsArabic;
}

<!-- Page Title -->
<!-- Page Header -->
<section class="relative w-full bg-gray-50 border-b border-gray-200 overflow-hidden mb-8">
    <!-- Polka Dots Pattern Background -->
    <div class="absolute inset-0 opacity-[0.6]"
         style="background-image: radial-gradient(#d1d5db 2px, transparent 2px); background-size: 24px 24px;">
    </div>
    
    <!-- Content -->
    <div class="container mx-auto px-4 py-12 md:py-16 relative z-10 text-center">
        <h1 class="text-3xl md:text-5xl font-bold text-gray-900 mb-4 tracking-tight">
            @ViewData["Title"]
        </h1>
        <div class="w-20 h-1 bg-gray-900 mx-auto rounded-full"></div>
    </div>
</section>

<!-- Filter Bar & Tools (Main Content Start) -->
<div class="container px-4 pb-16">

    <!-- Filter Bar & Tools -->
    <div class="flex flex-row justify-between items-center gap-4 mb-8">
        
        <!-- Categories Filter -->
        <div class="relative w-auto">
            <button id="browseBtn" onclick="toggleCategories()" 
                    class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 rounded-lg transition-colors duration-200 border border-gray-200">
                <span>@L["BrowseCategories"]</span>
                <i class="ph ph-caret-down text-gray-400"></i>
            </button>
            
            <!-- Dropdown -->
            <div id="categoriesDropdown" class="hidden absolute top-full @(isArabic ? "right-0" : "left-0") mt-2 w-56 bg-white border border-gray-100 rounded-lg shadow-lg z-50 py-1">
                <a href="javascript:void(0)" onclick="loadProducts(null)" 
                   class="block px-4 py-2.5 text-sm text-gray-600 hover:bg-gray-50 hover:text-black transition-colors @(Model.SelectedCategoryId == null ? "bg-gray-50 font-medium text-black" : "")">
                    @L["AllProducts"]
                </a>
                @foreach (var cat in Model.Categories)
                {
                    <a href="javascript:void(0)" onclick="loadProducts(@cat.Id)" 
                       class="block px-4 py-2.5 text-sm text-gray-600 hover:bg-gray-50 hover:text-black transition-colors @(Model.SelectedCategoryId == cat.Id ? "bg-gray-50 font-medium text-black" : "")">
                        @(isArabic ? cat.NameAr : cat.NameEn)
                    </a>
                }
            </div>
        </div>

        <!-- View Options -->
        <div class="flex items-center gap-4">
            <span class="text-sm text-gray-500">
                @Model.TotalProducts @L["Products"]
            </span>
            
            <!-- View Toggles -->
            <div class="flex items-center gap-1 bg-gray-50 p-1 rounded-lg border border-gray-100 view-toggle-container">
                <button onclick="setView('cols-1')" data-view="cols-1" 
                        class="p-1.5 text-gray-400 hover:text-black rounded transition-colors"
                        title="@L["OneColumn"]">
                    <i class="ph ph-square text-lg"></i>
                </button>
                <button onclick="setView('cols-2')" data-view="cols-2" 
                        class="p-1.5 text-gray-400 hover:text-black rounded transition-colors"
                        title="@L["TwoColumns"]">
                    <i class="ph ph-columns text-lg"></i>
                </button>
                <!-- Hidden on Mobile -->
                <button onclick="setView('cols-4')" data-view="cols-4" 
                        class="hidden md:block p-1.5 text-gray-400 hover:text-black rounded transition-colors view-btn-desktop-only"
                        title="@L["FourColumns"]">
                    <i class="ph ph-squares-four text-lg"></i>
                </button>
                <button onclick="setView('cols-6')" data-view="cols-6" 
                        class="hidden md:block p-1.5 text-gray-400 hover:text-black rounded transition-colors view-btn-desktop-only"
                        title="@L["SixColumns"]">
                    <i class="ph ph-grid-nine text-lg"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Products Grid Container -->
    <div id="productsContainer" class="min-h-[400px] transition-opacity duration-200">
        <partial name="_ProductList" model="Model" />
    </div>
</div>

@section Scripts {
    <style>
        /* Force hide specific buttons on mobile */
        @@media (max-width: 768px) {
            .view-btn-desktop-only {
                display: none !important;
            }
        }
    </style>
    <script>
        // Store current state
        let currentState = {
            category: @(Model.SelectedCategoryId?.ToString() ?? "null"),
            page: @Model.CurrentPage
        };

        function toggleCategories() {
            const dropdown = document.getElementById('categoriesDropdown');
            dropdown.classList.toggle('hidden');
        }

        // Close dropdowns when clicking outside
        document.addEventListener('click', function(e) {
            if (!e.target.closest('#browseBtn') && !e.target.closest('#categoriesDropdown')) {
                document.getElementById('categoriesDropdown').classList.add('hidden');
            }
        });

        // View Management
        function setView(viewMode) {
            const grid = document.getElementById('productsGrid');
            if (!grid) return;
            
            // Map view modes to Tailwind classes
            const viewClasses = {
                'cols-1': 'grid-cols-1',
                'cols-2': 'grid-cols-2',
                'cols-4': 'grid-cols-4',
                'cols-6': 'grid-cols-6'
            };

            // Remove all possible view classes
            Object.values(viewClasses).forEach(cls => grid.classList.remove(cls));
            
            // Add grid class if missing (ensure it's a grid)
            if (!grid.classList.contains('grid')) grid.classList.add('grid');

            // Add selected view class
            if (viewClasses[viewMode]) {
                 grid.classList.add(viewClasses[viewMode]);
            }
            
            // Update active button state
            document.querySelectorAll('[data-view]').forEach(btn => {
                const isActive = btn.dataset.view === viewMode;
                btn.className = isActive 
                    ? 'p-1.5 text-black bg-white shadow-sm rounded transition-colors' 
                    : 'p-1.5 text-gray-400 hover:text-black rounded transition-colors ' + (btn.classList.contains('view-btn-desktop-only') ? 'view-btn-desktop-only' : '');
            });
            
            // Save preference (store the abstract name 'cols-4', not the class)
            localStorage.setItem('productsView', viewMode);
        }

        function checkMobileView() {
            const isMobile = window.innerWidth < 768; // Tailwind md breakpoint
            const savedView = localStorage.getItem('productsView');
            
            if (isMobile) {
                // Mobile: Default to 2 columns
                // If there is no saved view, or if the saved view is invalid for mobile (4 or 6), force 2.
                if (!savedView || savedView === 'cols-4' || savedView === 'cols-6') {
                     setView('cols-2');
                } else {
                     // Respect user choice if it is cols-1 or cols-2
                     setView(savedView);
                }
            } else {
                // Desktop: Default to 4 columns if nothing is saved
                setView(savedView || 'cols-4');
            }
        }

        // Initial View Setup
        document.addEventListener('DOMContentLoaded', checkMobileView);
        
        // Handle Resize (optional, but good for testing responsiveness)
        window.addEventListener('resize', checkMobileView);


        // Navigation & AJAX
        function loadProducts(categoryId = null, page = 1) {
             const container = document.getElementById('productsContainer');
             container.style.opacity = '0.6'; // Smooth loading state
             
             // Update State
             currentState.category = categoryId;
             currentState.page = page;

             let url = `/Products?page=${page}`;
             if(categoryId) url += `&category=${categoryId}`;
             
             fetch(url, {
                 headers: { 'X-Requested-With': 'XMLHttpRequest' }
             })
             .then(response => response.text())
             .then(html => {
                 container.innerHTML = html;
                 container.style.opacity = '1';
                 
                 // Restore Grid View (important to prevent flash)
                 checkMobileView();
                 
                 // Push History
                 window.history.pushState(currentState, '', url);
                 
                 // Close dropdown
                 document.getElementById('categoriesDropdown').classList.add('hidden');
             })
             .catch(error => {
                 console.error('Error:', error);
                 container.style.opacity = '1';
             });
        }

        // Handle Browser Back/Forward Buttons
        window.onpopstate = function(event) {
            if (event.state) {
                // Restore from history state
                currentState = event.state;
                // We reload content via AJAX to match the history state
                // Note: we need to handle the 'null' category case carefully if standard fetch expects it.
                // Simpler: Just reload the URL currently in address bar via AJAX?
                // Or use the params from event.state.
                loadProductsByUrl(window.location.href);
            } else {
                // Initial state
                // loadProductsByUrl(window.location.href); 
                // Or do nothing as the page loaded normally? 
                // Using AJAX reload ensures smooth experience.
                window.location.reload(); 
            }
        };

        function loadProductsByUrl(url) {
             const container = document.getElementById('productsContainer');
             container.style.opacity = '0.6';
             
             fetch(url, {
                 headers: { 'X-Requested-With': 'XMLHttpRequest' }
             })
             .then(r => r.text())
             .then(html => {
                 container.innerHTML = html;
                 container.style.opacity = '1';
                 checkMobileView();
             });
        }
    </script>
}
