@model UniformPro.Web.ViewModels.ProductIndexViewModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<UniformPro.Web.Resources.SharedResource> L
@{
    var isArabic = Model.IsArabic;
}

<div class="container">
    @if (!Model.Products.Any())
    {
        <div class="text-center py-12 md:py-20">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gray-50 mb-4">
                <i class="ph ph-package text-3xl text-gray-400"></i>
            </div>
            <p class="text-gray-500 text-lg">@L["NoProducts"]</p>
        </div>
    }
    else
    {
        <!-- Grid Container -->
        <!-- Note: The parent 'productsGrid' logic might be in Index, but typically we want the grid classes here if this partial REPLACES the container. 
             However, in Index.cshtml I wrote: <div id="productsContainer"> <partial ... /> </div>
             So this partial should probably contain the #productsGrid div so that view classes work? 
             Actually, the JS toggles classes on 'productsGrid'. If I replace the inner HTML of 'productsContainer', I must ensure 'productsGrid' is inside.
        -->
        <div id="productsGrid" class="grid grid-cols-4 gap-6"> 
            @foreach (var product in Model.Products)
            {
                <div>
                    <div class="product-card group relative cursor-pointer" onclick="location.href='/Products/Details/@product.Id'">
                        <!-- Image -->
                        <div class="product-image-container relative overflow-hidden bg-gray-100 aspect-[3/4] rounded-lg mb-3">
                            @if (!string.IsNullOrEmpty(product.MainImagePath))
                            {
                                <img src="~/uploads/products/@product.MainImagePath" 
                                     alt="@(isArabic ? product.NameAr : product.NameEn)"
                                     class="product-image w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                            }
                            else
                            {
                                <div class="flex items-center justify-center w-full h-full text-gray-300">
                                    <i class="ph ph-image text-4xl"></i>
                                </div>
                            }
                            
                            <!-- Floating Add to Cart Button (Mobile friendly) -->
                            <button type="button" class="btn-add-cart-fab absolute bottom-3 right-3 w-10 h-10 bg-black text-white rounded-full flex items-center justify-center shadow-lg hover:bg-gray-800 transition-transform active:scale-95" 
                                    onclick="event.stopPropagation(); addToCart(@product.Id, '@(isArabic ? product.NameAr.Replace("'", "\\'") : product.NameEn.Replace("'", "\\'"))', '@(product.MainImagePath ?? "")')">
                                <i class="ph ph-handbag text-lg"></i>
                            </button>
                        </div>
                        
                        <!-- Info -->
                        <div class="product-info text-center">
                             <h3 class="product-name font-medium text-gray-900 group-hover:text-black truncate">
                                @(isArabic ? product.NameAr : product.NameEn)
                             </h3>
                            @{
                                var material = isArabic ? product.MaterialDetailsAr : product.MaterialDetailsEn;
                            }
                            @if (!string.IsNullOrEmpty(material))
                            {
                                <p class="text-xs text-gray-500 mt-1 truncate">@material</p>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        
        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="pagination-minimal flex justify-center items-center gap-2 mt-12 mb-8">
                @if (Model.CurrentPage > 1)
                {
                    <a href="/Products?category=@Model.SelectedCategoryId&page=@(Model.CurrentPage - 1)" 
                       onclick="event.preventDefault(); loadProducts(@(Model.SelectedCategoryId?.ToString() ?? "null"), @(Model.CurrentPage - 1))"
                       class="px-4 py-2 text-sm text-gray-600 border border-gray-200 rounded-lg hover:bg-black hover:text-white hover:border-black transition-colors flex items-center gap-2">
                        <i class="ph ph-arrow-@(isArabic ? "right" : "left")"></i> @L["Previous"]
                    </a>
                }
                
                <span class="text-sm text-gray-500 px-2">
                    @L["Page"] @Model.CurrentPage @L["Of"] @Model.TotalPages
                </span>
                
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a href="/Products?category=@Model.SelectedCategoryId&page=@(Model.CurrentPage + 1)" 
                       onclick="event.preventDefault(); loadProducts(@(Model.SelectedCategoryId?.ToString() ?? "null"), @(Model.CurrentPage + 1))"
                       class="px-4 py-2 text-sm text-gray-600 border border-gray-200 rounded-lg hover:bg-black hover:text-white hover:border-black transition-colors flex items-center gap-2">
                        @L["Next"] <i class="ph ph-arrow-@(isArabic ? "left" : "right")"></i>
                    </a>
                }
            </div>
        }
    }
    <input type="hidden" id="serverPageTitle" value="@ViewData["Title"]" />
</div>