@section Scripts {
    <script>
        // Slider Arrow Logic
        function initSliderArrow(sliderId) {
            const slider = document.getElementById(sliderId);
            if (!slider) return;

            const arrow = slider.parentElement.querySelector('.slider-arrow');
            if (!arrow) return;

            function checkScroll() {
                // Fixed RTL logic: use Math.abs because RTL scrollLeft is negative in modern browsers
                const currentScroll = Math.abs(slider.scrollLeft);
                const maxScroll = slider.scrollWidth - slider.clientWidth;
                
                // Check if we reached the physical end of the scroll container
                const isEnd = currentScroll >= maxScroll - 10; // 10px buffer
                const hasOverflow = slider.scrollWidth > slider.clientWidth;
                
                if (!isEnd && hasOverflow) {
                    arrow.classList.remove('hidden');
                } else {
                    arrow.classList.add('hidden');
                }
            }

            slider.addEventListener('scroll', checkScroll);
            window.addEventListener('resize', checkScroll);
            
            // Initial check
            checkScroll();
        }

        function scrollSlider(sliderId, direction) {
            const slider = document.getElementById(sliderId);
            if (slider) {
                // Update scroll amount for 3 items (approx 3 per screen)
                const itemsPerScreen = window.innerWidth >= 768 ? 3 : 2;
                const scrollAmount = slider.clientWidth / itemsPerScreen; 
                const isRTL = document.documentElement.dir === 'rtl';

                // Determine logical direction if not explicitly provided
                // Default behavior (no direction arg) is "Next"
                // Next in LTR = Scroll Right (+). Next in RTL = Scroll Left (-).
                let behaviorDirection = direction;
                if (!behaviorDirection) {
                    behaviorDirection = isRTL ? 'left' : 'right';
                }

                // Check end condition
                // In RTL, scrollLeft is often negative (Chrome) or starts at 0 and goes negative.
                // We use Math.abs to be safe.
                const currentScroll = Math.abs(slider.scrollLeft);
                const maxScroll = slider.scrollWidth - slider.clientWidth;
                // Buffer of 10px
                const reachedEnd = currentScroll >= maxScroll - 10;
                
                if (behaviorDirection === 'left') {
                    // Scrolling Left (Physical)
                    // In RTL, this is "Next". In LTR, this is "Prev".
                    // If RTL and reached max scroll (which is actually "Start" in some browsers or "End" physically?), 
                    // Actually in RTL: Start is Right (0 or Max). End is Left (Max or 0).
                    // Let's simplify: 
                    // To scroll MORE to the left (Next items in RTL): scrollBy({ left: -amount })
                    
                    if (isRTL && reachedEnd) {
                        // Loop back to Start (Right side)
                         slider.scrollTo({ left: 0, behavior: 'smooth' });
                    } else {
                         slider.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
                    }
                } else {
                    // direction === 'right' (Physical)
                    // In LTR, this is "Next". 
                    
                    if (!isRTL && reachedEnd) {
                         slider.scrollTo({ left: 0, behavior: 'smooth' }); // Loop back to Start (Left)
                    } else {
                         slider.scrollBy({ left: scrollAmount, behavior: 'smooth' });
                    }
                }
            }
        }

        // Auto Play Logic
        function initAutoPlay(sliderId, intervalTime = 3000) {
            const slider = document.getElementById(sliderId);
            if (!slider) return;
            
            let autoPlayInterval;
            const isRTL = document.documentElement.dir === 'rtl';

            function start() {
                stop();
                autoPlayInterval = setInterval(() => {
                    // Only scroll if not hovered
                     if (!slider.parentElement.matches(':hover')) {
                        // In RTL, 'Next' is Left. In LTR, 'Next' is Right.
                        scrollSlider(sliderId, isRTL ? 'left' : 'right');
                    }
                }, intervalTime);
            }

            function stop() {
                clearInterval(autoPlayInterval);
            }

            // Pause on interaction
            slider.parentElement.addEventListener('mouseenter', stop);
            slider.parentElement.addEventListener('mouseleave', start);
            slider.addEventListener('touchstart', stop);
            slider.addEventListener('touchend', start);

            start();
        }

        // Mouse Drag Logic with Click Prevention
        function enableMouseDrag(sliderId) {
            const slider = document.getElementById(sliderId);
            if (!slider) return;

            let isDown = false;
            let startX;
            let scrollLeft;
            let isDragging = false;

            slider.addEventListener('mousedown', (e) => {
                isDown = true;
                isDragging = false;
                slider.classList.add('cursor-grabbing');
                slider.classList.remove('cursor-grab');
                startX = e.pageX - slider.offsetLeft;
                scrollLeft = slider.scrollLeft;
                slider.style.scrollSnapType = 'none'; 
            });

            slider.addEventListener('mouseleave', () => {
                isDown = false;
                slider.classList.remove('cursor-grabbing');
                slider.classList.add('cursor-grab');
                slider.classList.remove('active');
                if(slider.style.scrollSnapType === 'none') slider.style.scrollSnapType = '';
            });

            slider.addEventListener('mouseup', () => {
                isDown = false;
                slider.classList.remove('cursor-grabbing');
                slider.classList.add('cursor-grab');
                if(slider.style.scrollSnapType === 'none') slider.style.scrollSnapType = '';
                setTimeout(() => { isDragging = false; }, 50);
            });

            slider.addEventListener('mousemove', (e) => {
                if (!isDown) return;
                e.preventDefault();
                const x = e.pageX - slider.offsetLeft;
                const walk = (x - startX) * 1.5; 
                if (Math.abs(x - startX) > 5) isDragging = true;
                slider.scrollLeft = scrollLeft - walk;
            });

            const preventClick = (e) => {
                if (isDragging) {
                    e.preventDefault();
                    e.stopPropagation();
                }
            };

            const clickables = slider.querySelectorAll('a, button, .cursor-pointer, video');
            clickables.forEach(el => {
                el.addEventListener('click', preventClick, true);
            });
            
            slider.dataset.isDragging = "false";
            slider.addEventListener('mousemove', () => {
                 if(isDragging) slider.dataset.isDragging = "true";
            });
            slider.addEventListener('mouseup', () => {
                 setTimeout(() => slider.dataset.isDragging = "false", 50);
            });
        }

        function playCardYoutube(el, url) {
            if (el.closest('.cursor-grabbing')) return; 
            el.innerHTML = `<iframe src="${url}?autoplay=1" class="w-full h-full" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>`;
        }
        
        // Local Video Play Logic
        function playLocalVideo(container) {
            const slider = container.closest('.overflow-x-auto');
            if(slider && slider.dataset.isDragging === "true") return;

            const video = container.querySelector('video');
            const cover = container.querySelector('.cover-img');
            const overlay = container.querySelector('.play-overlay');
            
            if(video) {
                if(cover) cover.classList.add('opacity-0', 'pointer-events-none');
                if(overlay) overlay.classList.add('opacity-0', 'hidden'); 
                video.controls = true;
                video.play();
                container.onclick = null;
            }
        }

        // Init sliders on load
        document.addEventListener('DOMContentLoaded', () => {
            initSliderArrow('latestProductsSlider');
            initSliderArrow('portfolioSlider');
            
            enableMouseDrag('latestProductsSlider');
            enableMouseDrag('portfolioSlider');
            enableMouseDrag('happyCustomersSlider');
            enableMouseDrag('clientsSlider');

            initAutoPlay('happyCustomersSlider', 3000);
            initAutoPlay('clientsSlider', 3000);
        });

        // Hero Carousel Logic (Only runs if element exists)
        (function() {
            const carousel = document.getElementById('heroCarousel');
            // If no carousel (single image), exit immediately
            if (!carousel) return;

            const dots = document.querySelectorAll('.hero-dot');
            // Use safe count from rendered HTML or default to 0
            const slideCount = dots.length > 0 ? dots.length : 0; 
            if(slideCount <= 1) return;

            let currentSlide = 0;
            let autoPlayInterval;

            function goToSlide(index) {
                currentSlide = index;
                const isRTL = document.documentElement.dir === 'rtl';
                // In RTL, items are laid out Right-to-Left. 
                // To view the 'next' item (physically to the left), we must shift the container Right (Positive X).
                // In LTR, we shift Left (Negative X).
                const translateVal = isRTL ? (index * 100) : -(index * 100);
                
                carousel.style.transform = `translateX(${translateVal}%)`;
                dots.forEach((dot, i) => {
                    dot.classList.toggle('active', i === index);
                });
            }

            function nextSlide() {
                currentSlide = (currentSlide + 1) % slideCount;
                goToSlide(currentSlide);
            }

            function prevSlide() {
                currentSlide = (currentSlide - 1 + slideCount) % slideCount;
                goToSlide(currentSlide);
            }

            function startAutoPlay() {
                autoPlayInterval = setInterval(nextSlide, 5000);
            }

            function stopAutoPlay() {
                clearInterval(autoPlayInterval);
            }

            window.goToSlide = function(index) {
                stopAutoPlay();
                goToSlide(index);
                startAutoPlay();
            };

            startAutoPlay();

            const wrapper = document.getElementById('heroCarouselWrapper');
            if(wrapper) {
                // Allow vertical scroll but capture horizontal swipe
                wrapper.style.touchAction = 'pan-y';

                wrapper.addEventListener('mouseenter', stopAutoPlay);
                wrapper.addEventListener('mouseleave', startAutoPlay);

                // Swipe Support
                let touchStartX = 0;
                let touchEndX = 0;
                let touchStartY = 0;
                let touchEndY = 0;
                
                wrapper.addEventListener('touchstart', e => {
                    touchStartX = e.changedTouches[0].clientX;
                    touchStartY = e.changedTouches[0].clientY;
                    stopAutoPlay();
                }, {passive: true});

                wrapper.addEventListener('touchend', e => {
                    touchEndX = e.changedTouches[0].clientX;
                    touchEndY = e.changedTouches[0].clientY;
                    handleSwipe();
                    startAutoPlay();
                }, {passive: true});

                function handleSwipe() {
                    const swipeThreshold = 50;
                    const deltaX = touchEndX - touchStartX;
                    const deltaY = touchEndY - touchStartY;

                    // Ignore if vertical scroll was dominant
                    if (Math.abs(deltaY) > Math.abs(deltaX)) return;

                    const isRTL = document.documentElement.dir === 'rtl';

                    if (Math.abs(deltaX) > swipeThreshold) {
                        if (deltaX < 0) {
                             // Swiped Left -> Next (LTR) / Prev (RTL)
                             isRTL ? prevSlide() : nextSlide();
                        } else {
                             // Swiped Right -> Prev (LTR) / Next (RTL)
                             isRTL ? nextSlide() : prevSlide();
                        }
                    }
                }
            }
        })();

        // Features Slider Logic
        (function() {
            const slider = document.getElementById('featuresSlider');
            const dots = document.querySelectorAll('#featuresDots button');
            if (!slider || !dots.length) return;

            let isScrolling;

            // Update dots on scroll
            slider.addEventListener('scroll', () => {
                window.clearTimeout(isScrolling);
                
                // Set a timeout to run after scrolling ends
                isScrolling = setTimeout(() => {
                    const scrollLeft = slider.scrollLeft;
                    const width = slider.clientWidth;
                    // Calculate active index based on scroll position - simplified for RTL/LTR
                    const index = Math.round(Math.abs(scrollLeft) / width);
                    
                    dots.forEach((dot, i) => {
                        if (i === index) {
                            dot.classList.add('bg-gray-800', 'active');
                            dot.classList.remove('bg-gray-300');
                        } else {
                            dot.classList.remove('bg-gray-800', 'active');
                            dot.classList.add('bg-gray-300');
                        }
                    });
                }, 66);
            });

            // Scroll to specific feature
            window.scrollToFeature = function(index) {
                const width = slider.clientWidth;
                const isRTL = document.documentElement.dir === 'rtl';
                // For scrollLeft, LTR is positive, RTL is negative (or positive depending on browser implementation, 
                // but usually negative in Chrome/Edge, positive in Firefox/Safari but starting from max).
                // Safest bet for cross-browser RTL scroll is scrollTo options behavior or using element offset.
                
                // Let's use simple calculation relative to item width which is 100% of slider in mobile
                const targetScroll = isRTL ? -(index * width) : (index * width);
                
                slider.scrollTo({
                    left: targetScroll,
                    behavior: 'smooth'
                });
            };

            // Enable mouse drag
            enableMouseDrag('featuresSlider');
        })();
    </script>
}