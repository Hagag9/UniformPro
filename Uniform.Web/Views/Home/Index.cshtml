@using UniformPro.Core.Entities
@using UniformPro.Core.Helpers
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<UniformPro.Web.Resources.SharedResource> L
@model UniformPro.Web.ViewModels.HomeViewModel
@{
    Layout = "_FrontLayout";
    ViewData["Title"] = L["Home"];
    var isArabic = ViewData["IsArabic"] as bool? ?? true;
    var heroItems = Model.HeroItems?.ToList() ?? new List<HeroItem>();
    var hasHero = heroItems.Any();
    var isCarousel = heroItems.Count > 1;
}

@section Head {
    @{
        var socialLinks = new List<string>();
        if (!string.IsNullOrEmpty(Model.SiteSettings.FacebookUrl)) { socialLinks.Add(Model.SiteSettings.FacebookUrl); }
        if (!string.IsNullOrEmpty(Model.SiteSettings.InstagramUrl)) { socialLinks.Add(Model.SiteSettings.InstagramUrl); }
        if (!string.IsNullOrEmpty(Model.SiteSettings.TikTokUrl)) { socialLinks.Add(Model.SiteSettings.TikTokUrl); }
        if (!string.IsNullOrEmpty(Model.SiteSettings.YoutubeUrl)) { socialLinks.Add(Model.SiteSettings.YoutubeUrl); }
    }
    <script type="application/ld+json">
    {
      "@@context": "https://schema.org",
      "@@type": "LocalBusiness",
      "name": "@(isArabic ? Model.SiteSettings.WebsiteNameAr : Model.SiteSettings.WebsiteNameEn)",
      "image": "@Url.Content($"~/uploads/sitesettings/{Model.SiteSettings.LogoPath}")",
      "telephone": "@Model.SiteSettings.PhoneNumber",
      "address": {
        "@@type": "PostalAddress",
        "streetAddress": "@(isArabic ? Model.SiteSettings.AddressAr : Model.SiteSettings.AddressEn)"
      },
      "sameAs": @Html.Raw(Json.Serialize(socialLinks))
    }
    </script>
}

@section Styles {
    <style>
        /* Hero Section Styles */
        .hero-section {
            height: 70vh;
            min-height: 500px;
            max-height: 800px;
        }
        @@media (min-width: 768px) {
            .hero-section {
                height: 85vh;
                max-height: 900px;
            }
        }

        /* Carousel Styles */
        .hero-carousel {
            display: flex;
            transition: transform 0.6s ease-in-out;
        }
        .hero-slide {
            min-width: 100%;
            position: relative;
        }
        .hero-slide img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Dots Navigation */
        .hero-dots {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 30;
            display: flex;
            gap: 8px;
        }
        .hero-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: rgba(255,255,255,0.5);
            cursor: pointer;
            transition: all 0.3s;
        }
        .hero-dot.active {
            background: white;
            transform: scale(1.2);
        }

        /* Content Animation */
        .hero-content {
            animation: fadeInUp 0.8s ease-out;
        }
        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        /* Hide Scrollbar Utility */
        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .hide-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        /* Force Desktop Slider Layout */
        @@media (min-width: 768px) {
            #latestProductsSlider, #portfolioSlider {
                gap: 2.5rem !important; /* 40px */
            }
            #latestProductsSlider > a, #portfolioSlider > a {
                width: calc(25% - 1.875rem) !important; /* (100% - 3*gap) / 4 */
            }
        }
        /* Marquee Animation */
        .marquee-container {
            mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
            -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
        }
        
        .marquee-track {
            display: flex;
            gap: 1.5rem; /* gap-6 */
            width: max-content;
            animation: marquee-scroll 40s linear infinite;
        }

        .marquee-track:hover {
            animation-play-state: paused;
        }
        
        /* RTL Support for Marquee */
        html[dir="rtl"] .marquee-track {
            animation: marquee-scroll-rtl 40s linear infinite;
        }

        @@keyframes marquee-scroll {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }

        @@keyframes marquee-scroll-rtl {
            0% { transform: translateX(0); }
            100% { transform: translateX(50%); } /* In RTL, positive types move right */
        }
        
        @@media (min-width: 768px) {
            .marquee-track {
                gap: 3rem; /* gap-12 */
            }
        }
    </style>
}

@if (hasHero)
{
    <!-- ========== HERO SECTION ========== -->
    <section class="hero-section relative overflow-hidden">

        @if (!isCarousel)
        {
            <!-- ===== STATIC MODE (1 صورة) ===== -->
            var item = heroItems.First();
            <picture class="absolute inset-0 z-0">
                @if (!string.IsNullOrEmpty(item.MobileImagePath))
                {
                    <source media="(max-width: 768px)" srcset="~/uploads/hero/@item.MobileImagePath">
                }
                <img src="~/uploads/hero/@item.ImagePath" 
                     alt="@(isArabic ? item.TitleAr : item.TitleEn)" 
                     class="w-full h-full object-cover"
                     loading="eager" fetchpriority="high">
            </picture>

            <!-- Overlay -->
            @if (item.HasOverlay)
            {
                <div class="absolute inset-0 bg-black/50 z-10"></div>
            }

            <!-- Content -->
            <div class="hero-content absolute inset-0 z-20 flex items-center justify-center">
                <div class="container mx-auto px-4 text-center">
                    <h1 class="text-3xl md:text-5xl lg:text-6xl font-bold text-white mb-4 leading-tight">
                        @(isArabic ? item.TitleAr : item.TitleEn)
                    </h1>
                    @if (!string.IsNullOrEmpty(isArabic ? item.SubtitleAr : item.SubtitleEn))
                    {
                        <p class="text-lg md:text-xl text-white/80 mb-6 max-w-2xl mx-auto">
                            @(isArabic ? item.SubtitleAr : item.SubtitleEn)
                        </p>
                    }
                    @if (!string.IsNullOrEmpty(item.LinkUrl))
                    {
                        <a href="@item.LinkUrl" 
                           class="inline-flex items-center gap-2 px-8 py-3 bg-white text-gray-900 font-bold rounded-full hover:bg-gray-100 transition-all hover:scale-105 shadow-lg">
                            <span>@L["OrderNow"]</span>
                            <i class="ph-bold ph-arrow-right @(isArabic ? "rotate-180" : "")"></i>
                        </a>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- ===== CAROUSEL MODE (2+ صور) ===== -->
            <div id="heroCarouselWrapper" class="absolute inset-0 z-0 overflow-hidden">
                <div id="heroCarousel" class="hero-carousel h-full">
                    @{ int slideIndex = 0; }
                    @foreach (var item in heroItems)
                    {
                        var isFirstSlide = slideIndex == 0;
                        <div class="hero-slide">
                            <picture>
                                @if (!string.IsNullOrEmpty(item.MobileImagePath))
                                {
                                    <source media="(max-width: 768px)" srcset="~/uploads/hero/@item.MobileImagePath">
                                }
                                <img src="~/uploads/hero/@item.ImagePath" 
                                     alt="@(isArabic ? item.TitleAr : item.TitleEn)"
                                     loading="@(isFirstSlide ? "eager" : "lazy")"
                                     fetchpriority="@(isFirstSlide ? "high" : "auto")">
                            </picture>
                        @{ slideIndex++; }

                            <!-- Per-slide Overlay -->
                            @if (item.HasOverlay)
                            {
                                <div class="absolute inset-0 bg-black/50"></div>
                            }

                            <!-- Per-slide Content -->
                            <div class="absolute inset-0 flex items-center justify-center">
                                <div class="container mx-auto px-4 text-center">
                                    <h2 class="text-3xl md:text-5xl lg:text-6xl font-bold text-white mb-4 leading-tight">
                                        @(isArabic ? item.TitleAr : item.TitleEn)
                                    </h2>
                                    @if (!string.IsNullOrEmpty(isArabic ? item.SubtitleAr : item.SubtitleEn))
                                    {
                                        <p class="text-lg md:text-xl text-white/80 mb-6 max-w-2xl mx-auto">
                                            @(isArabic ? item.SubtitleAr : item.SubtitleEn)
                                        </p>
                                    }
                                    @if (!string.IsNullOrEmpty(item.LinkUrl))
                                    {
                                        <a href="@item.LinkUrl" 
                                           class="inline-flex items-center gap-2 px-8 py-3 bg-white text-gray-900 font-bold rounded-full hover:bg-gray-100 transition-all hover:scale-105 shadow-lg">
                                            <span>@L["OrderNow"]</span>
                                            <i class="ph-bold ph-arrow-right @(isArabic ? "rotate-180" : "")"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Dots Navigation -->
            <div class="hero-dots">
                @for (int i = 0; i < heroItems.Count; i++)
                {
                    <button class="hero-dot @(i == 0 ? "active" : "")" 
                            onclick="goToSlide(@i)" 
                            aria-label="Slide @(i + 1)"></button>
                }
            </div>
        }

    </section>
}
else
{
    <!-- ===== NO HERO - FALLBACK ===== -->
    <section class="hero-section relative bg-gradient-to-br from-gray-900 to-gray-800 flex items-center justify-center">
        <div class="text-center text-white px-4">
            <i class="ph ph-image text-6xl mb-4 opacity-50"></i>
            <h1 class="text-3xl md:text-4xl font-bold mb-2">@L["Welcome"]</h1>
            <p class="text-white/70">@L["NoHeroImages"]</p>
        </div>
    </section>
}

@{
    var latestProducts = Model.LatestProducts?.ToList() ?? new List<UniformPro.Core.Entities.Product>();
}

@if (latestProducts.Any())
{
    <!-- ========== LATEST PRODUCTS SECTION ========== -->
    <section class="py-14 bg-white">
        <div class="container mx-auto px-6 md:px-12 lg:px-20">
            <!-- Header -->
            <div class="text-center mb-8 md:mb-12">
                <h2 class="text-lg md:text-3xl font-bold text-gray-900 uppercase tracking-wide">
                    @L["LatestProducts"]
                </h2>
            </div>

            <!-- Products Slider -->
            <div class="relative group/slider">
                <div id="latestProductsSlider" class="flex overflow-x-auto snap-x snap-mandatory gap-2 md:gap-10 pb-4 hide-scrollbar md:pb-0 cursor-grab active:cursor-grabbing">
                    @foreach (var product in latestProducts)
                    {
                        <a href="/Products/Details/@product.Id" class="group w-[calc(50%-0.25rem)] md:w-[calc(25%-1.875rem)] flex-shrink-0 snap-start select-none">
                            <!-- Image -->
                            <div class="aspect-[4/5] overflow-hidden mb-2">
                                <img src="~/uploads/products/@product.MainImagePath" 
                                     alt="@(isArabic ? product.NameAr : product.NameEn)"
                                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            </div>
                            
                            <!-- Title (Centered) -->
                            <div class="text-center px-1">
                                <h3 class="text-sm md:text-base font-medium text-gray-900 group-hover:text-primary transition-colors line-clamp-2">
                                    @(isArabic ? product.NameAr : product.NameEn)
                                </h3>
                            </div>
                        </a>
                    }
                </div>
                <!-- Scroll Hint Arrow -->
                <button onclick="scrollSlider('latestProductsSlider')" class="slider-arrow absolute @(isArabic ? "left-0 rotate-180" : "right-0") top-1/2 -translate-y-1/2 z-10 bg-white/80 backdrop-blur shadow-lg rounded-full p-2 animate-pulse hidden">
                    <i class="ph-bold ph-arrow-right text-primary text-xl"></i>
                </button>
            </div>
            
            <!-- View All Button -->
            <div class="mt-8 text-center md:mt-12">
                <a href="/Products" class="inline-block px-10 py-3 text-sm md:text-base font-bold text-white transition-all bg-black rounded-full hover:bg-gray-800 hover:scale-105 shadow-md">
                    @L["ViewAll"]
                </a>
            </div>

        </div>
    </section>

}

@{
    var homePortfolios = Model.Portfolios?.ToList() ?? new List<UniformPro.Web.ViewModels.PortfolioCardViewModel>();
}

@if (homePortfolios.Any())
{
    <!-- ========== PREVIOUS WORK SECTION ========== -->
    <section class="pb-14 pt-4 bg-gray-50">
        <div class="container mx-auto px-6 md:px-12 lg:px-20">
            <!-- Header -->
            <div class="text-center mb-8 md:mb-12">
                <h2 class="text-lg md:text-3xl font-bold text-gray-900 uppercase tracking-wide">
                    @L["PreviousWork"]
                </h2>
            </div>

            <!-- Portfolio Slider (Mobile: 2 items, Desktop: 4 items) -->
            <div class="relative group/p-slider">
                <div id="portfolioSlider" class="flex overflow-x-auto snap-x snap-mandatory gap-2 md:gap-10 pb-4 hide-scrollbar cursor-grab active:cursor-grabbing">
                    @foreach (var item in homePortfolios)
                    {
                        <a href="/Portfolio/Details/@item.Id" class="group w-[calc(50%-0.25rem)] md:w-[calc(25%-1.875rem)] flex-shrink-0 snap-start relative select-none">
                            <!-- Image Card -->
                            <div class="aspect-[4/5] overflow-hidden mb-2 relative">
                                <img src="~/uploads/portfolios/covers/@item.CoverImagePath" 
                                     alt="@(isArabic ? item.ClientNameAr : item.ClientNameEn)"
                                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                                 
                                 <!-- Overlay Gradient for text readability -->
                                 <div class="absolute inset-x-0 bottom-0 top-1/2 bg-gradient-to-t from-black/80 to-transparent"></div>
                                 
                                 <!-- Text Content -->
                                 <div class="absolute bottom-4 left-4 right-4">
                                    <p class="text-xs text-white/80 mb-1">@(isArabic ? item.CategoryNameAr : item.CategoryNameEn)</p>
                                    <h3 class="text-sm md:text-base font-bold text-white line-clamp-2">
                                        @(isArabic ? item.ClientNameAr : item.ClientNameEn)
                                    </h3>
                                 </div>
                            </div>
                        </a>
                    }
                </div>
                <!-- Scroll Hint Arrow -->
                <button onclick="scrollSlider('portfolioSlider')" class="slider-arrow absolute @(isArabic ? "left-0 rotate-180" : "right-0") top-1/2 -translate-y-1/2 z-10 bg-white/80 backdrop-blur shadow-lg rounded-full p-2 animate-pulse hidden">
                    <i class="ph-bold ph-arrow-right text-primary text-xl"></i>
                </button>
            </div>
            
            <!-- View All Button -->
            <div class="mt-8 text-center md:mt-12">
                <a href="/Portfolio" class="inline-block px-10 py-3 text-sm md:text-base font-bold text-white transition-all bg-black rounded-full hover:bg-gray-800 hover:scale-105 shadow-md">
                    @L["ViewAll"]
                </a>
            </div>
        </div>
    </section>
}

<!-- ========== VALUE PROPOSITION SECTION ========== -->
<section class="py-16 md:py-24 bg-white relative overflow-hidden">
    <div class="container mx-auto px-6 md:px-12 lg:px-20 text-center relative z-10">
        
        <!-- Brand Label -->
        <span class="block text-xs md:text-sm font-bold tracking-widest text-gray-500 uppercase mb-3 md:mb-5">
            MANO UNIFORM
        </span>

        <!-- Main Heading -->
        <h2 class="text-xl md:text-3xl font-bold text-gray-900 leading-tight mb-4 max-w-3xl mx-auto" style="text-wrap: balance;">
            @L["ValueProp_Heading"]
        </h2>

        <!-- Description -->
        <p class="text-gray-600 text-sm md:text-base leading-relaxed max-w-2xl mx-auto mb-12 md:mb-20" style="text-wrap: balance;">
            @L["ValueProp_Desc"]
        </p>

        <!-- Section Header -->
         <h3 class="text-base md:text-xl font-bold text-gray-900 uppercase tracking-wide mb-8 md:mb-12">
            @L["WhyMano"]
        </h3>

        <!-- Features Grid / Slider -->
        <div class="relative group/features-slider">
            <div id="featuresSlider" class="flex md:grid md:grid-cols-2 gap-x-4 gap-y-10 md:gap-x-12 md:gap-y-16 overflow-x-auto snap-x snap-mandatory hide-scrollbar pb-4 md:pb-0">
                
                <!-- Feature 1: Quality and Finishing -->
                <div class="w-full md:w-auto flex-shrink-0 snap-center flex flex-col items-center group text-center" style="scroll-snap-stop: always;">
                    <div class="w-16 h-16 md:w-20 md:h-20 flex items-center justify-center mb-6 text-gray-800 transition-transform group-hover:scale-110">
                        <i class="ph-thin ph-t-shirt text-5xl md:text-6xl"></i>
                    </div>
                    <h3 class="text-lg md:text-xl font-bold text-gray-900 mb-3">@L["Feat_QualityFinish_Title"]</h3>
                    <p class="text-gray-600 text-sm md:text-base leading-relaxed max-w-xs mx-auto">
                        @L["Feat_QualityFinish_Desc"]
                    </p>
                </div>

                <!-- Feature 2: Creativity and Variety -->
                <div class="w-full md:w-auto flex-shrink-0 snap-center flex flex-col items-center group text-center" style="scroll-snap-stop: always;">
                    <div class="w-16 h-16 md:w-20 md:h-20 flex items-center justify-center mb-6 text-gray-800 transition-transform group-hover:scale-110">
                        <i class="ph-thin ph-lightbulb text-5xl md:text-6xl"></i>
                    </div>
                    <h3 class="text-lg md:text-xl font-bold text-gray-900 mb-3">@L["Feat_Creativity_Title"]</h3>
                    <p class="text-gray-600 text-sm md:text-base leading-relaxed max-w-xs mx-auto">
                        @L["Feat_Creativity_Desc"]
                    </p>
                </div>

                <!-- Feature 3: Fast Delivery -->
                <div class="w-full md:w-auto flex-shrink-0 snap-center flex flex-col items-center group text-center" style="scroll-snap-stop: always;">
                    <div class="w-16 h-16 md:w-20 md:h-20 flex items-center justify-center mb-6 text-gray-800 transition-transform group-hover:scale-110">
                        <i class="ph-thin ph-timer text-5xl md:text-6xl"></i>
                    </div>
                    <h3 class="text-lg md:text-xl font-bold text-gray-900 mb-3">@L["Feat_FastDelivery_Title"]</h3>
                    <p class="text-gray-600 text-sm md:text-base leading-relaxed max-w-xs mx-auto">
                        @L["Feat_FastDelivery_Desc"]
                    </p>
                </div>

                <!-- Feature 4: Flexible Partnerships -->
                <div class="w-full md:w-auto flex-shrink-0 snap-center flex flex-col items-center group text-center" style="scroll-snap-stop: always;">
                    <div class="w-16 h-16 md:w-20 md:h-20 flex items-center justify-center mb-6 text-gray-800 transition-transform group-hover:scale-110">
                        <i class="ph-thin ph-handshake text-5xl md:text-6xl"></i>
                    </div>
                    <h3 class="text-lg md:text-xl font-bold text-gray-900 mb-3">@L["Feat_FlexPartner_Title"]</h3>
                    <p class="text-gray-600 text-sm md:text-base leading-relaxed max-w-xs mx-auto">
                        @L["Feat_FlexPartner_Desc"]
                    </p>
                </div>

            </div>

            <!-- Mobile Dots Navigation -->
            <div id="featuresDots" class="flex md:hidden justify-center gap-2 mt-6">
                <button class="w-2.5 h-2.5 rounded-full bg-gray-800 transition-all duration-300 active" onclick="scrollToFeature(0)"></button>
                <button class="w-2.5 h-2.5 rounded-full bg-gray-300 transition-all duration-300" onclick="scrollToFeature(1)"></button>
                <button class="w-2.5 h-2.5 rounded-full bg-gray-300 transition-all duration-300" onclick="scrollToFeature(2)"></button>
                <button class="w-2.5 h-2.5 rounded-full bg-gray-300 transition-all duration-300" onclick="scrollToFeature(3)"></button>
            </div>
        </div>

</section>





@{
    var testimonials = Model.Testimonials?.ToList() ?? new List<UniformPro.Core.Entities.Testimonial>();
}

@if (testimonials.Any())
{
    <!-- ========== HAPPY CUSTOMERS SECTION ========== -->
    <section class="py-14 bg-gray-50 border-t border-gray-100">
        <div class="container mx-auto px-6 md:px-12 lg:px-20">
            <!-- Header -->
            <div class="text-center mb-10">
                <h2 class="text-2xl md:text-4xl font-bold text-gray-900 mb-2 font-outfit">
                    @L["HappyCustomers"] <span class="text-3xl md:text-4xl">🤩</span>
                </h2>
                <p class="text-gray-500 text-sm md:text-base">@L["FromReviews"]</p>
            </div>

            <!-- Testimonials Slider Wrapper (3 Cards Centered on Desktop) -->
            <div class="relative group/t-slider max-w-[85%] xl:max-w-3xl mx-auto">
                
                <div id="happyCustomersSlider" class="flex overflow-x-auto snap-x snap-mandatory gap-4 pb-4 hide-scrollbar cursor-grab active:cursor-grabbing scroll-smooth @(testimonials.Count < 5 ? "md:justify-center" : "")" style="scroll-padding-left: 0;">
                    @foreach (var item in testimonials)
                    {
                        <!-- Card: Video Based (3 items desktop) -->
                        <div class="w-[calc(50%-0.5rem)] md:w-[calc(33.333%-0.75rem)] flex-shrink-0 snap-center bg-white rounded-xl shadow-sm border border-gray-100 overflow-visible flex flex-col hover:shadow-md transition-shadow select-none h-auto mt-4 mb-2">
                            
                            <!-- Video Container (Top) - Aspect 4/5 -->
                            <div class="aspect-[4/5] bg-black relative group video-container rounded-t-xl overflow-hidden">
                                @if (!string.IsNullOrEmpty(item.YoutubeUrl))
                                {
                                     <div class="w-full h-full cursor-pointer relative" onclick="playCardYoutube(this, '@YoutubeHelper.GetEmbedUrl(item.YoutubeUrl)')">
                                         <img src="@( !string.IsNullOrEmpty(item.CoverImage) ? Url.Content($"~/uploads/testimonials/covers/{item.CoverImage}") : YoutubeHelper.GetThumbnailUrl(item.YoutubeUrl) )" 
                                              class="w-full h-full object-cover opacity-100 transition-opacity" draggable="false">
                                         
                                         <!-- Play Button (Show on Hover) -->
                                         <div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                                              <div class="w-12 h-12 bg-white/90 backdrop-blur rounded-full flex items-center justify-center shadow-xl group-hover:scale-110 transition-transform">
                                                  <i class="ph-fill ph-play text-red-600 text-xl pl-1"></i>
                                              </div>
                                         </div>
                                     </div>
                                }
                                else if (!string.IsNullOrEmpty(item.VideoPath))
                                {
                                     var hasCover = !string.IsNullOrEmpty(item.CoverImage);
                                     <div class="w-full h-full relative cursor-pointer" onclick="@(hasCover ? "playLocalVideo(this)" : "")">
                                         @if(hasCover) {
                                             <img src="~/uploads/testimonials/covers/@item.CoverImage" class="absolute inset-0 w-full h-full object-cover z-20 transition-opacity duration-300 cover-img">
                                             <!-- Play Button Overlay -->
                                             <div class="absolute inset-0 z-30 flex items-center justify-center pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-300 play-overlay">
                                                  <div class="w-12 h-12 bg-white/90 backdrop-blur rounded-full flex items-center justify-center shadow-xl group-hover:scale-110 transition-transform">
                                                       <i class="ph-fill ph-play text-gray-900 text-xl pl-1"></i>
                                                  </div>
                                             </div>
                                         }
                                         
                                         <video src="~/uploads/testimonials/videos/@item.VideoPath" 
                                                class="w-full h-full object-cover" 
                                                controls="@(hasCover ? null : "controls")" 
                                                preload="none"
                                                poster="@(!string.IsNullOrEmpty(item.ImagePath) ? Url.Content($"~/uploads/testimonials/images/{item.ImagePath}") : "")"></video>
                                     </div>
                                }
                                else
                                {
                                    <!-- Fallback if no video, show Image covering -->
                                     <div class="w-full h-full relative">
                                        @if(!string.IsNullOrEmpty(item.ImagePath)){
                                            <img src="~/uploads/testimonials/images/@item.ImagePath" class="w-full h-full object-cover" draggable="false">
                                        } else {
                                            <div class="w-full h-full flex items-center justify-center bg-gray-100 text-gray-300">
                                                <i class="ph-duotone ph-video-camera-slash text-4xl"></i>
                                            </div>
                                        }
                                     </div>
                                }
                            </div>

                            <!-- Content Body -->
                            <div class="p-4 pt-10 flex flex-col items-center text-center relative bg-white rounded-b-xl">
                                
                                <!-- Large Avatar (Overlapping) -->
                                <div class="absolute -top-7 left-1/2 -translate-x-1/2 w-14 h-14 rounded-full border-4 border-white shadow-md overflow-hidden bg-gray-100 z-10">
                                    @if (!string.IsNullOrEmpty(item.ImagePath))
                                    {
                                        <img src="~/uploads/testimonials/images/@item.ImagePath" class="w-full h-full object-cover" draggable="false">
                                    }
                                    else
                                    {
                                        <div class="w-full h-full flex items-center justify-center text-gray-400"><i class="ph-fill ph-user text-xl"></i></div>
                                    }
                                </div>

                                <!-- Stars -->
                                <div class="flex gap-0.5 text-yellow-400 text-xs mb-2">
                                    <i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i>
                                </div>

                                <!-- Client Name & Verified -->
                                <div class="flex items-center gap-1.5 mb-2">
                                    <h4 class="text-sm font-bold text-gray-900 truncate max-w-[120px]" title="@item.ClientName">@item.ClientName</h4>
                                    <span class="bg-blue-50 text-blue-600 text-[10px] font-bold px-1.5 py-0.5 rounded flex items-center gap-0.5" title="@L["VerifiedCustomer"]">
                                        <i class="ph-fill ph-check-circle"></i>
                                    </span>
                                </div>

                                <!-- Feedback -->
                                <p class="text-gray-600 text-xs leading-relaxed line-clamp-2 italic w-full">
                                    "@item.Feedback"
                                </p>
                            </div>

                        </div>
                    }
                </div>
                
                <!-- Bottom Controls (Arrows) -->
                <div class="flex justify-center items-center gap-6 mt-6" dir="ltr">
                    <button onclick="scrollSlider('happyCustomersSlider', 'left')" class="w-10 h-10 rounded-full border border-gray-300 flex items-center justify-center text-gray-500 hover:border-black hover:text-black transition-colors">
                        <i class="ph-bold ph-caret-left text-xl"></i>
                    </button>
                    <button onclick="scrollSlider('happyCustomersSlider', 'right')" class="w-10 h-10 rounded-full border border-gray-300 flex items-center justify-center text-gray-500 hover:border-black hover:text-black transition-colors">
                        <i class="ph-bold ph-caret-right text-xl"></i>
                    </button>
                </div>

            </div>
        </div>
    </section>
}



