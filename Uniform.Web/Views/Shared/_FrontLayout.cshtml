<!DOCTYPE html>
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<UniformPro.Web.Resources.SharedResource> L
@{
    var isArabic = ViewData["IsArabic"] as bool? ?? true;
    var lang = ViewData["Lang"]?.ToString() ?? "ar";
    var dir = ViewData["Dir"]?.ToString() ?? "rtl";
    var siteName = isArabic ? ViewData["SiteNameAr"]?.ToString() : ViewData["SiteNameEn"]?.ToString();
    siteName = siteName ?? L["SiteNameDefault"];
    var currentPath = Context.Request.Path.ToString().ToLower();
    bool isHomePage = currentPath == "/" || currentPath == "/home" || currentPath == "/home/index";
}
<html lang="@lang" dir="@dir">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - @siteName</title>

    @if (ViewData["PixelId"] != null && !string.IsNullOrEmpty(ViewData["PixelId"].ToString()))
    {
        <!-- Meta Pixel Code -->
        <script>
            !function(f,b,e,v,n,t,s)
            {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
            n.callMethod.apply(n,arguments):n.queue.push(arguments)};
            if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
            n.queue=[];t=b.createElement(e);t.async=!0;
            t.src=v;s=b.getElementsByTagName(e)[0];
            s.parentNode.insertBefore(t,s)}(window, document,'script',
            'https://connect.facebook.net/en_US/fbevents.js');
            fbq('init', '@ViewData["PixelId"]');
            fbq('track', 'PageView');
        </script>
        <noscript><img height="1" width="1" style="display:none"
        src="https://www.facebook.com/tr?id=@ViewData["PixelId"]&ev=PageView&noscript=1"
        /></noscript>
        <!-- End Meta Pixel Code -->
    }

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Cairo', 'sans-serif'] },
                    colors: {
                        primary: '#374151',       /* Gray-700 */
                        'primary-dark': '#1f2937', /* Gray-800 */
                        secondary: '#f9fafb',      /* Gray-50 */
                        dark: '#111827',           /* Gray-900 */
                        accent: '#6b7280',         /* Gray-500 */
                    }
                }
            }
        }
    </script>

    <script src="https://unpkg.com/@@phosphor-icons/web"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    
    <!-- Custom Styles -->
    <link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;500;600;700&family=Readex+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="~/css/front-custom.css" rel="stylesheet" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="bg-white text-gray-800 antialiased @(isHomePage ? "" : "pt-16 md:pt-20") flex flex-col min-h-screen overflow-x-hidden"
      data-i18n-added-to-cart="@L["AddedToCart"]"
      data-i18n-cart-empty="@L["CartEmpty"]"
      data-i18n-inquiry-msg="@L["InquiryMessage"]"
      data-whatsapp-number="@ViewData["WhatsApp"]">

    <header id="mainHeader" class="dutch-header @(isHomePage ? "is-home" : "")">
        <div class="container mx-auto px-4">
            <div class="flex items-center justify-between h-16 md:h-20 relative">

                <button id="mobile-menu-btn" class="p-2 text-gray-600 hover:text-gray-900" onclick="toggleMobileMenu()">
                    <i class="ph-bold ph-list text-2xl"></i>
                </button>

                <a href="/" class="dutch-logo absolute left-1/2 transform -translate-x-1/2 whitespace-nowrap">
                    @siteName
                </a>

                <div class="flex items-center gap-2 md:gap-3">
                    <button onclick="toggleInquiryCart()" class="relative p-2 text-gray-600 hover:text-gray-900 group">
                        <i class="ph ph-shopping-cart text-xl"></i>
                        <span id="cartBadge" class="hidden absolute -top-1 @(isArabic ? "-left-1" : "-right-1") bg-gray-900 text-white text-xs w-5 h-5 rounded-full flex items-center justify-center pointer-events-none">0</span>
                    </button>

                </div>
            </div>
        </div>
    </header>

    <div id="mobile-menu-overlay" class="fixed inset-0 bg-black/40 backdrop-blur-sm z-40 hidden transition-all duration-300" onclick="toggleMobileMenu()"></div>
    <nav id="mobile-menu" class="fixed top-0 @(isArabic ? "right-0 translate-x-full" : "left-0 -translate-x-full") h-full w-72 bg-white z-[60] shadow-xl flex flex-col transition-transform duration-300">
        <div class="flex items-center justify-between p-4 border-b">
            <!-- Sidebar Header: Logo -->
             <a href="/" class="flex items-center gap-2">
                @if (ViewData["LogoPath"] != null)
                {
                    <img src="~/uploads/sitesettings/@ViewData["LogoPath"]" class="h-8 w-auto" alt="@siteName" />
                }
                else
                {
                    <img src="/images/Logo-color.svg" class="h-8 w-auto" alt="@siteName" />
                }
                <span class="text-sm font-bold text-gray-800">@siteName</span>
            </a>
            <button onclick="toggleMobileMenu()" class="p-2 text-gray-500 hover:text-gray-800 transition-colors">
                <i class="ph-bold ph-x text-2xl"></i>
            </button>
        </div>
        
        @{
            // var currentPath is now defined at the top of the file
            string GetActiveClass(string path, bool exact = true)
            {
                if (path == "/" && currentPath == "/") return "bg-gray-100 text-gray-900 font-bold border-l-4 border-gray-900";
                if (path != "/" && (exact ? currentPath == path.ToLower() : currentPath.StartsWith(path.ToLower())))
                    return "bg-gray-100 text-gray-900 font-bold border-l-4 border-gray-900";
                
                return "text-gray-600 font-medium hover:bg-gray-50 hover:text-gray-900 border-l-4 border-transparent";
            }
            
             string GetIconClass(string path, bool exact = true)
            {
                 if (path == "/" && currentPath == "/") return "text-gray-900";
                 if (path != "/" && (exact ? currentPath == path.ToLower() : currentPath.StartsWith(path.ToLower())))
                    return "text-gray-900";
                
                return "text-gray-400 group-hover:text-gray-900";
            }
        }
        
        <div class="flex-1 px-3 py-2 overflow-y-auto custom-scrollbar">
            <div class="space-y-1">
                <a href="/" class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition-all group @GetActiveClass("/")">
                    <i class="ph ph-house text-xl @GetIconClass("/")"></i>
                    @L["Home"]
                </a>
                
                <!-- Products Dropdown -->
                <div x-data="{ open: @(currentPath.StartsWith("/products") ? "true" : "false") }" class="border-b border-gray-50 last:border-0"> 
                    <button onclick="toggleSubmenu('productsSubmenu')" class="w-full flex items-center justify-between px-3 py-2.5 rounded-lg transition-all group @GetActiveClass("/products", false)">
                        <div class="flex items-center gap-3">
                            <i class="ph ph-tag text-xl @GetIconClass("/products", false)"></i>
                            @L["Products"]
                        </div>
                        <i id="productsSubmenuIcon" class="ph ph-caret-down transition-transform duration-300 @(currentPath.StartsWith("/products") ? "rotate-180 text-gray-900" : "text-gray-400")"></i>
                    </button>
                    <div id="productsSubmenu" class="@(currentPath.StartsWith("/products") ? "" : "hidden") pl-9 pr-4 space-y-0 pb-1">
                        <!-- Categories Via ViewComponent -->
                        <vc:sidebar-categories />
                    </div>
                </div>

                <a href="/Portfolio" class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition-all group @GetActiveClass("/portfolio")">
                    <i class="ph ph-briefcase text-xl @GetIconClass("/portfolio")"></i>
                    @L["Portfolio"]
                </a>
                
                <a href="/DiscountPolicy" class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition-all group @GetActiveClass("/discountpolicy")">
                    <i class="ph ph-percent text-xl @GetIconClass("/discountpolicy")"></i>
                    @L["DiscountPolicy"]
                </a>

                <a href="/Testimonials" class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition-all group @GetActiveClass("/testimonials", false)">
                     <i class="ph ph-star text-xl @GetIconClass("/testimonials", false)"></i>
                    @L["Feedback"]
                </a>
                
                <a href="/Contact" class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition-all group @GetActiveClass("/contact")">
                     <i class="ph ph-envelope text-xl @GetIconClass("/contact")"></i>
                    @L["Contact"]
                </a>

                <a href="/Home/About" class="flex items-center gap-3 px-3 py-2.5 rounded-lg transition-all group @GetActiveClass("/home/about")">
                     <i class="ph ph-info text-xl @GetIconClass("/home/about")"></i>
                    @L["AboutUs"]
                </a>
            </div>
        </div>

        <div class="bg-gray-50 p-3 border-t">
            <div class="flex items-center justify-between">
                <a href="/Language/Switch?culture=@(isArabic ? "en" : "ar")&returnUrl=@Context.Request.Path"
                   class="flex items-center gap-2 px-3 py-1.5 bg-white border border-gray-200 rounded-full shadow-sm hover:shadow-md text-xs font-bold text-gray-700 transition-all">
                    <i class="ph ph-globe text-sm"></i>
                    @L["LanguageSwitchLabel"]
                </a>

                <a href="/Admin" class="text-gray-400 hover:text-gray-600" title="@L["AdminLogin"]">
                    <i class="ph ph-lock-key text-xl"></i>
                </a>
            </div>
        </div>
    </nav>

    <main class="flex-1 w-full">
        @RenderBody()
    </main>

    <footer class="bg-neutral-900 text-gray-300 pt-10 pb-6 border-t border-neutral-800">
        <div class="container mx-auto px-4">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-8">
                
                <!-- Company Info -->
                <div class="space-y-4">
                    <a href="/" class="flex items-center gap-3">
                        @if (ViewData["LogoPath"] != null)
                        {
                            <img src="~/uploads/sitesettings/@ViewData["LogoPath"]" class="h-14 w-auto" alt="@siteName" />
                        }
                        else
                        {
                            <img src="/images/Logo-color.png" class="h-14 w-auto" alt="@siteName" />
                        }
                        <span class="text-lg font-bold text-white">@siteName</span>
                    </a>
                    <p class="text-gray-400 text-sm leading-relaxed">
                        @L["CompanyDesc"]
                    </p>
                </div>

                <!-- Quick Links -->
                <div>
                    <h3 class="text-white font-bold text-base mb-4 relative inline-block">
                        @L["QuickLinks"]
                        <span class="absolute bottom-0 @(isArabic ? "right-0" : "left-0") w-1/2 h-0.5 bg-primary rounded-full"></span>
                    </h3>
                    <ul class="space-y-2">
                        <li><a href="/" class="text-gray-400 hover:text-white hover:translate-x-1 transition-all duration-300 inline-block text-sm">@L["Home"]</a></li>
                        <li><a href="/Products" class="text-gray-400 hover:text-white hover:translate-x-1 transition-all duration-300 inline-block text-sm">@L["Products"]</a></li>
                        <li><a href="/Portfolio" class="text-gray-400 hover:text-white hover:translate-x-1 transition-all duration-300 inline-block text-sm">@L["Portfolio"]</a></li>
                        <li><a href="/DiscountPolicy" class="text-gray-400 hover:text-white hover:translate-x-1 transition-all duration-300 inline-block text-sm">@L["DiscountPolicy"]</a></li>
                        <li><a href="/Home/About" class="text-gray-400 hover:text-white hover:translate-x-1 transition-all duration-300 inline-block text-sm">@L["AboutUs"]</a></li>
                    </ul>
                </div>

                <!-- Contact Info -->
                <div>
                    <h3 class="text-white font-bold text-base mb-4 relative inline-block">
                        @L["Contact"]
                        <span class="absolute bottom-0 @(isArabic ? "right-0" : "left-0") w-1/2 h-0.5 bg-primary rounded-full"></span>
                    </h3>
                    <ul class="space-y-3">
                         <li class="flex items-start gap-3">
                            <i class="ph-fill ph-map-pin text-primary text-lg mt-0.5"></i>
                            <span class="text-gray-400 text-sm leading-relaxed">
                                @(isArabic ? ViewData["AddressAr"] : ViewData["AddressEn"])
                            </span>
                        </li>
                        <li class="flex items-center gap-3">
                            <i class="ph-fill ph-phone text-primary text-lg"></i>
                            <div class="flex items-center gap-2 text-sm text-gray-400">
                                <a href="tel:@ViewData["Phone"]" class="hover:text-white transition-colors" dir="ltr">@ViewData["Phone"]</a>
                                @if(ViewData["Phone2"] != null)
                                {
                                    <span class="text-gray-500">-</span>
                                    <a href="tel:@ViewData["Phone2"]" class="hover:text-white transition-colors" dir="ltr">@ViewData["Phone2"]</a>
                                }
                            </div>
                        </li>
                        <li class="flex items-center gap-3">
                            <i class="ph-fill ph-whatsapp-logo text-primary text-lg"></i>
                            @{
                                var waFooter = ViewData["WhatsApp"]?.ToString() ?? "";
                                var waFooterClean = System.Text.RegularExpressions.Regex.Replace(waFooter, @"\D", ""); // Remove non-digits
                            }
                             <a href="https://api.whatsapp.com/send?phone=@waFooterClean" target="_blank" class="text-gray-400 hover:text-white transition-colors text-sm" dir="ltr">@ViewData["WhatsApp"]</a>
                        </li>
                    </ul>

                    <!-- Social Media (Moved here) -->
                    <div class="flex gap-3 flex-wrap mt-6">
                        @if (ViewData["Facebook"] != null)
                        {
                            <a href="@ViewData["Facebook"]" target="_blank" class="w-9 h-9 rounded-full bg-gray-700 flex items-center justify-center text-gray-400 hover:bg-[#1877F2] hover:text-white transition-all transform hover:-translate-y-1">
                                <i class="ph-fill ph-facebook-logo text-lg"></i>
                            </a>
                        }
                        @if (ViewData["Instagram"] != null)
                        {
                            <a href="@ViewData["Instagram"]" target="_blank" class="w-9 h-9 rounded-full bg-gray-700 flex items-center justify-center text-gray-400 hover:bg-[#E4405F] hover:text-white transition-all transform hover:-translate-y-1">
                                <i class="ph-fill ph-instagram-logo text-lg"></i>
                            </a>
                        }
                        @if (ViewData["TikTok"] != null)
                        {
                            <a href="@ViewData["TikTok"]" target="_blank" class="w-9 h-9 rounded-full bg-gray-700 flex items-center justify-center text-gray-400 hover:bg-[#000000] hover:text-white transition-all transform hover:-translate-y-1">
                                <i class="ph-fill ph-tiktok-logo text-lg"></i>
                            </a>
                        }
                         @if (ViewData["Youtube"] != null)
                        {
                            <a href="@ViewData["Youtube"]" target="_blank" class="w-9 h-9 rounded-full bg-gray-700 flex items-center justify-center text-gray-400 hover:bg-[#FF0000] hover:text-white transition-all transform hover:-translate-y-1">
                                <i class="ph-fill ph-youtube-logo text-lg"></i>
                            </a>
                        }
                    </div>
                </div>

                <!-- Follow Us -->
                <!-- Our Office (Map) -->
                 <div>
                    <h3 class="text-white font-bold text-base mb-4 relative inline-block">
                        @L["OurOffice"]
                        <span class="absolute bottom-0 @(isArabic ? "right-0" : "left-0") w-1/2 h-0.5 bg-primary rounded-full"></span>
                    </h3>
                    
                    @if (ViewData["MapUrl"] != null && !string.IsNullOrEmpty(ViewData["MapUrl"].ToString()))
                    {
                        <div class="rounded-lg overflow-hidden border border-gray-700 shadow-md">
                            <iframe src="@ViewData["MapUrl"]" 
                                    class="w-full h-48 border-0" 
                                    allowfullscreen="" 
                                    loading="lazy" 
                                    referrerpolicy="no-referrer-when-downgrade">
                            </iframe>
                        </div>
                    }
                    else
                    {
                        <div class="h-48 bg-gray-800 rounded-lg flex items-center justify-center text-gray-500 text-sm border border-gray-700">
                           @L["NoMapAvailable"]
                        </div>
                    }
                </div>

            </div>
            
            <div class="border-t border-gray-700 pt-6 mt-4 flex flex-col md:flex-row justify-between items-center gap-4">
                <p class="text-gray-500 text-xs text-center md:text-start">
                    &copy; @DateTime.Now.Year @siteName. @L["AllRightsReserved"]
                </p>
                <div class="flex items-center gap-1 text-xs text-gray-500">
                    <span>@L["DesignedBy"]</span>
                    <a href="https://www.linkedin.com/in/ahagag/" class="text-primary hover:text-white font-bold transition-colors">@@Ahmed Hagag</a>
                </div>
            </div>
        </div>
    </footer>

    <div class="fixed bottom-6 @(isArabic ? "left-6" : "right-6") z-30 flex flex-col gap-3">
        <a href="tel:@ViewData["Phone"]"
           class="w-14 h-14 bg-gray-800 hover:bg-gray-700 text-white rounded-full flex items-center justify-center shadow-lg hover:shadow-xl transform hover:scale-110 transition-all duration-300"
           title="@L["CallNow"]">
            <i class="ph-fill ph-phone text-2xl"></i>
        </a>
        <a href="https://api.whatsapp.com/send?phone=@(System.Text.RegularExpressions.Regex.Replace(ViewData["WhatsApp"]?.ToString() ?? "", @"\D", ""))" target="_blank"
           class="w-14 h-14 bg-green-500 hover:bg-green-600 text-white rounded-full flex items-center justify-center shadow-lg hover:shadow-xl transform hover:scale-110 transition-all duration-300"
           title="@L["WhatsAppContact"]">
            <i class="ph-fill ph-whatsapp-logo text-3xl"></i>
        </a>
    </div>

    <!-- Scroll To Top Button -->
    <button id="scrollTopBtn" 
            onclick="scrollToTop()"
            class="fixed bottom-6 @(isArabic ? "right-6" : "left-6") z-30 w-12 h-12 bg-black text-white rounded-full shadow-lg flex items-center justify-center transform translate-y-20 opacity-0 transition-all duration-300 hover:bg-gray-800 hover:-translate-y-1 focus:outline-none"
            aria-label="Scroll to top">
        <i class="ph-bold ph-arrow-up text-xl"></i>
    </button>

    <div id="cartOverlay" class="fixed inset-0 bg-black/40 backdrop-blur-sm z-40 hidden transition-all duration-300" onclick="toggleInquiryCart()"></div>
    
    <div id="inquiryCartSidebar" class="fixed top-0 h-full w-80 bg-white shadow-xl z-[60] flex flex-col">
        <div class="p-4 border-b flex items-center justify-between">
            <button onclick="toggleInquiryCart()" class="text-gray-400 hover:text-gray-800 transition-colors">
                <i class="ph-bold ph-x text-xl"></i>
            </button>
            <h3 class="font-bold text-lg text-gray-900 absolute left-1/2 transform -translate-x-1/2">@L["ShoppingCart"]</h3>
            <div class="w-5"></div> <!-- Spacer for centering -->
        </div>
        
        <div id="cartItems" class="flex-1 overflow-y-auto p-4 custom-scrollbar"></div>
        
        <div class="p-4 border-t space-y-3 bg-white">
            <button onclick="InquiryCart.generateWhatsAppMessage()" class="w-full bg-green-500 hover:bg-green-600 text-white py-3.5 rounded-xl font-bold flex items-center justify-center gap-2 shadow-lg shadow-green-100 transition-all hover:-translate-y-0.5">
                <i class="ph-bold ph-whatsapp-logo text-xl"></i> @L["SendViaWhatsApp"]
            </button>
            <button onclick="InquiryCart.clear()" class="w-full border-2 border-gray-100 text-gray-500 hover:text-red-500 hover:border-red-100 hover:bg-red-50 py-3 rounded-xl text-sm font-semibold transition-all">
                @L["ClearCart"]
            </button>
        </div>
    </div>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="~/js/front-main.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
