@using UniformPro.Core.Helpers
@using Microsoft.Extensions.Localization
@model IEnumerable<UniformPro.Core.Entities.Testimonial>
@inject IStringLocalizer<UniformPro.Web.Resources.SharedResource> L

@{
    var isArabic = ViewData["IsArabic"] as bool? ?? false;
    ViewData["Title"] = L["CustomersAreSaying"];
}

<link rel="preconnect" href="https://www.youtube.com" crossorigin>
<link rel="preconnect" href="https://i.ytimg.com" crossorigin>

<style>
    /* Slider Container */
    #testimonial-slider {
        -webkit-overflow-scrolling: touch;
        position: relative;
    }
    
    #testimonial-track {
        scroll-behavior: smooth;
        will-change: transform;
        -webkit-transform: translateZ(0);
        transform: translateZ(0);
    }
    
    /* Cards Touch Optimization for iPhone */
    .testimonial-card {
        touch-action: pan-y pinch-zoom;
        -webkit-tap-highlight-color: transparent;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
    }
    
    /* Video Container - iPhone Safe */
    .video-container {
        position: relative;
        -webkit-transform: translateZ(0);
        transform: translateZ(0);
    }
    
    .video-container video,
    .video-container iframe {
        display: block;
        max-width: 100%;
    }
    
    /* Loading State */
    #testimonial-slider.loading {
        opacity: 0.6;
        pointer-events: none;
    }
    
    /* Progress Bar */
    .progress-bar-container {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: rgba(0, 0, 0, 0.1);
        overflow: hidden;
        z-index: 5;
    }
    
    .progress-bar {
        height: 100%;
        background: linear-gradient(90deg, #f97316, #ea580c);
        width: 0%;
        transition: width 100ms linear;
    }
    
    .progress-bar.animating {
        transition: width 7000ms linear;
    }
    
    /* Pagination Dots */
    .pagination-dots {
        display: flex;
        justify-content: center;
        gap: 8px;
        padding: 16px 0;
    }
    
    .pagination-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #d1d5db;
        transition: all 0.3s ease;
        cursor: pointer;
    }
    
    .pagination-dot.active {
        background: #f97316;
        width: 24px;
        border-radius: 4px;
    }
    
    /* Navigation Buttons Enhancement */
    .nav-btn {
        transition: all 0.3s ease;
        user-select: none;
        -webkit-user-select: none;
    }
    
    .nav-btn:active {
        transform: translateY(-50%) scale(0.95);
    }
    
    .nav-btn:disabled {
        opacity: 0.3;
        cursor: not-allowed;
    }
    
    /* Smooth Transitions */
    .transition-smooth {
        transition: transform 500ms cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    /* iPhone Notch Safe Area */
    @@supports (padding: max(0px)) {
        .container {
            padding-left: max(1rem, env(safe-area-inset-left));
            padding-right: max(1rem, env(safe-area-inset-right));
        }
    }
    
    /* Improve text rendering on iPhone */
    .testimonial-card {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }
    
    /* Lazy Load Placeholder */
    .lazy-thumbnail {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        position: relative;
        overflow: hidden;
    }
    
    .lazy-thumbnail::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
        animation: shimmer 2s infinite;
    }
    
    @@keyframes shimmer {
        0% { transform: translateX(-100%); }
        100% { transform: translateX(100%); }
    }
    
    /* Focus Styles for Accessibility */
    .nav-btn:focus-visible,
    .pagination-dot:focus-visible {
        outline: 2px solid #f97316;
        outline-offset: 2px;
    }
</style>

<div class="bg-white pt-8 pb-4 border-b border-gray-100">
    <div class="container mx-auto px-4 text-center">
        <h1 class="text-2xl md:text-4xl font-bold text-gray-900 font-outfit mb-2">
            @L["CustomersAreSaying"]
        </h1>
        <div class="flex justify-center gap-1 text-orange-400 text-sm" role="img" aria-label="4.5 stars rating">
            <i class="ph-fill ph-star"></i>
            <i class="ph-fill ph-star"></i>
            <i class="ph-fill ph-star"></i>
            <i class="ph-fill ph-star"></i>
            <i class="ph-fill ph-star-half"></i>
        </div>
    </div>
</div>

<div class="bg-gray-50 py-8">
    <div class="container mx-auto px-4 relative max-w-6xl">
        
        <button 
            class="nav-btn hidden md:flex absolute top-1/2 left-0 xl:-left-12 -translate-y-1/2 z-10 bg-white hover:bg-primary hover:text-white text-gray-800 w-10 h-10 rounded-full shadow-md items-center justify-center transition-colors" 
            onclick="testimonialSlider.prev()" 
            id="prevBtn"
            aria-label="Previous testimonial">
            <i class="ph-bold ph-caret-left text-xl"></i>
        </button>
        <button 
            class="nav-btn hidden md:flex absolute top-1/2 right-0 xl:-right-12 -translate-y-1/2 z-10 bg-white hover:bg-primary hover:text-white text-gray-800 w-10 h-10 rounded-full shadow-md items-center justify-center transition-colors" 
            onclick="testimonialSlider.next()" 
            id="nextBtn"
            aria-label="Next testimonial">
            <i class="ph-bold ph-caret-right text-xl"></i>
        </button>

        <div class="overflow-hidden relative" 
             id="testimonial-slider" 
             role="region" 
             aria-roledescription="carousel"
             aria-label="Customer testimonials">
            
            <div class="progress-bar-container">
                <div class="progress-bar" id="autoplay-progress"></div>
            </div>
            
            <div class="flex transition-smooth" id="testimonial-track">
                @{int itemIndex = 0;}
                @foreach (var item in Model)
                {
                    var thumbnailUrl = !string.IsNullOrEmpty(item.YoutubeUrl) ? YoutubeHelper.GetThumbnailUrl(item.YoutubeUrl) : null;
                    
                    <div class="w-full sm:w-1/2 lg:w-1/3 flex-shrink-0 px-3 py-2" 
                         role="group"
                         aria-roledescription="slide"
                         aria-label="Testimonial @(itemIndex + 1) of @Model.Count()">
                        <div class="testimonial-card bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden h-full flex flex-col hover:shadow-lg transition-shadow duration-300">
                            
                            <div class="aspect-[9/16] max-h-80 bg-black relative group video-container border-b border-gray-100">
                                @if (!string.IsNullOrEmpty(item.YoutubeUrl))
                                {
                                    <div class="w-full h-full cursor-pointer relative" 
                                         onclick="testimonialSlider.playYoutube(this, '@YoutubeHelper.GetEmbedUrl(item.YoutubeUrl)')"
                                         role="button"
                                         tabindex="0"
                                         aria-label="Play video testimonial"
                                         onkeypress="if(event.key==='Enter'||event.key===' ') testimonialSlider.playYoutube(this, '@YoutubeHelper.GetEmbedUrl(item.YoutubeUrl)')">
                                        <img 
                                            data-src="@thumbnailUrl" 
                                            src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 9'%3E%3C/svg%3E"
                                            class="lazy-thumbnail w-full h-full object-cover opacity-90 group-hover:opacity-100 transition-opacity"
                                            alt="Video thumbnail"
                                            loading="lazy">
                                        <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                                            <div class="w-14 h-14 bg-white/90 backdrop-blur rounded-full flex items-center justify-center shadow-xl group-hover:scale-110 transition-transform">
                                                <i class="ph-fill ph-play text-red-600 text-2xl pl-1"></i>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else if (!string.IsNullOrEmpty(item.VideoPath))
                                {
                                    <video 
                                        src="~/uploads/testimonials/videos/@item.VideoPath" 
                                        controls 
                                        preload="metadata"
                                        playsinline
                                        class="w-full h-full object-cover"
                                        aria-label="Customer testimonial video"></video>
                                }
                                else
                                {
                                    <div class="w-full h-full flex items-center justify-center bg-gray-100 text-gray-300">
                                        <i class="ph-duotone ph-video-camera-slash text-4xl"></i>
                                    </div>
                                }
                            </div>

                            <div class="p-5 flex flex-col flex-grow text-center relative bg-white">
                                <blockquote class="text-gray-700 text-sm leading-relaxed mb-4 italic line-clamp-3">
                                    "@item.Feedback"
                                </blockquote>

                                <div class="flex justify-center gap-1 text-yellow-400 text-xs mb-3" role="img" aria-label="5 stars rating">
                                    <i class="ph-fill ph-star"></i>
                                    <i class="ph-fill ph-star"></i>
                                    <i class="ph-fill ph-star"></i>
                                    <i class="ph-fill ph-star"></i>
                                    <i class="ph-fill ph-star"></i>
                                </div>

                                <div class="mt-auto pt-3 border-t border-gray-50 flex flex-col items-center">
                                    <div class="w-12 h-12 rounded-full border-2 border-white shadow-md p-0.5 mb-2 -mt-8 bg-white overflow-hidden">
                                        @if (!string.IsNullOrEmpty(item.ImagePath))
                                        {
                                            <img 
                                                src="~/uploads/testimonials/images/@item.ImagePath" 
                                                class="w-full h-full rounded-full object-cover"
                                                alt="@item.ClientName"
                                                loading="lazy">
                                        }
                                        else
                                        {
                                            <div class="w-full h-full rounded-full bg-gray-50 flex items-center justify-center text-gray-400">
                                                <i class="ph-fill ph-user"></i>
                                            </div>
                                        }
                                    </div>
                                    
                                    <h3 class="text-base font-bold text-gray-900">@item.ClientName</h3>
                                    <p class="text-gray-400 text-xs mt-0.5 font-medium">
                                        @if (isArabic) { 
                                            @(string.IsNullOrEmpty(item.ProductNameAr) ? item.Position : item.ProductNameAr) 
                                        }
                                        else { 
                                            @(string.IsNullOrEmpty(item.ProductNameEn) ? item.Position : item.ProductNameEn) 
                                        }
                                    </p>
                                </div>
                            </div>

                        </div>
                    </div>
                    itemIndex++;
                }
            </div>
        </div>

        <div class="pagination-dots" id="pagination-dots" role="tablist" aria-label="Testimonial pages">
            </div>

    </div>
</div>

@section Scripts {
    <script>
        // Testimonial Slider - Fixed Version (Logic + Anti-Ghost-Swipe)
        const testimonialSlider = (() => {
            // State
            let state = {
                currentIndex: 0,
                isTransitioning: false,
                autoPlayInterval: null,
                progressInterval: null,
                touchStart: { x: 0, y: 0, time: 0 },
                touchEnd: { x: 0, y: 0 },
                resizeTimeout: null,
                isAutoPlayPaused: false,
                isVideoPlaying: false // New state to track video playing
            };

            // Configuration
            const config = {
                autoPlayDelay: 7000,
                transitionDuration: 500,
                swipeThreshold: 50,
                autoPlayResumeDelay: 3000,
                progressUpdateInterval: 50
            };

            // DOM Elements
            const elements = {
                slider: document.getElementById('testimonial-slider'),
                track: document.getElementById('testimonial-track'),
                prevBtn: document.getElementById('prevBtn'),
                nextBtn: document.getElementById('nextBtn'),
                progressBar: document.getElementById('autoplay-progress'),
                dotsContainer: document.getElementById('pagination-dots')
            };

            // Helpers
            const getItemsPerScreen = () => {
                const width = window.innerWidth;
                if (width >= 1024) return 3;
                if (width >= 640) return 2;
                return 1;
            };

            const getMaxIndex = () => {
                const totalItems = elements.track.children.length;
                return Math.max(0, totalItems - getItemsPerScreen());
            };

            const getTotalItems = () => elements.track.children.length;

            const isRTL = () => document.documentElement.dir === 'rtl';

            // Update slider position
            const updateSlider = (animate = true) => {
                if (state.isTransitioning) return;

                const itemsPerScreen = getItemsPerScreen();
                const totalItems = getTotalItems();
                const itemWidth = 100 / itemsPerScreen;
                const maxIndex = getMaxIndex();

                if (state.currentIndex < 0) state.currentIndex = maxIndex;
                if (state.currentIndex > maxIndex) state.currentIndex = 0;

                if (totalItems <= itemsPerScreen) {
                    elements.track.classList.add('justify-center');
                    elements.track.style.transform = 'translateX(0)';
                    updateButtons();
                    return;
                } else {
                    elements.track.classList.remove('justify-center');
                }

                const translateVal = state.currentIndex * itemWidth;

                if (animate) {
                    state.isTransitioning = true;
                    elements.slider.classList.add('loading');
                    elements.track.style.transition = `transform ${config.transitionDuration}ms cubic-bezier(0.4, 0, 0.2, 1)`;
                } else {
                    elements.track.style.transition = 'none';
                }

                elements.track.style.transform = `translateX(${isRTL() ? translateVal : -translateVal}%)`;

                if (animate) {
                    setTimeout(() => {
                        state.isTransitioning = false;
                        elements.slider.classList.remove('loading');
                    }, config.transitionDuration);
                }

                updateAriaLabels();
                updateButtons();
                updateDots();
            };

            const updateAriaLabels = () => {
                const totalItems = getTotalItems();
                elements.slider.setAttribute('aria-live', 'polite');
                elements.slider.setAttribute('aria-label', `Testimonial ${state.currentIndex + 1} of ${totalItems}`);
            };

            const updateButtons = () => {
                const maxIndex = getMaxIndex();
                const totalItems = getTotalItems();

                if (totalItems <= getItemsPerScreen()) {
                    if (elements.prevBtn) elements.prevBtn.disabled = true;
                    if (elements.nextBtn) elements.nextBtn.disabled = true;
                    return;
                }

                if (elements.prevBtn) elements.prevBtn.disabled = false;
                if (elements.nextBtn) elements.nextBtn.disabled = false;
            };

            const createDots = () => {
                const totalPages = Math.ceil(getTotalItems() / getItemsPerScreen());
                elements.dotsContainer.innerHTML = '';

                if (totalPages <= 1) return;

                for (let i = 0; i < totalPages; i++) {
                    const dot = document.createElement('button');
                    dot.className = 'pagination-dot';
                    dot.setAttribute('role', 'tab');
                    dot.setAttribute('aria-label', `Go to page ${i + 1}`);
                    dot.setAttribute('aria-selected', i === state.currentIndex ? 'true' : 'false');
                    dot.onclick = () => goToSlide(i);
                    elements.dotsContainer.appendChild(dot);
                }
                updateDots();
            };

            const updateDots = () => {
                const dots = elements.dotsContainer.children;
                Array.from(dots).forEach((dot, i) => {
                    if (i === state.currentIndex) {
                        dot.classList.add('active');
                        dot.setAttribute('aria-selected', 'true');
                    } else {
                        dot.classList.remove('active');
                        dot.setAttribute('aria-selected', 'false');
                    }
                });
            };

            // Navigation functions
            const next = () => {
                if (state.isTransitioning) return;
                state.isVideoPlaying = false; // Reset video lock
                const maxIndex = getMaxIndex();
                state.currentIndex = state.currentIndex >= maxIndex ? 0 : state.currentIndex + 1;
                updateSlider();
                restartAutoPlay();
            };

            const prev = () => {
                if (state.isTransitioning) return;
                state.isVideoPlaying = false; // Reset video lock
                const maxIndex = getMaxIndex();
                state.currentIndex = state.currentIndex <= 0 ? maxIndex : state.currentIndex - 1;
                updateSlider();
                restartAutoPlay();
            };

            const goToSlide = (index) => {
                if (state.isTransitioning) return;
                state.isVideoPlaying = false; // Reset video lock
                const maxIndex = getMaxIndex();
                state.currentIndex = Math.max(0, Math.min(index, maxIndex));
                updateSlider();
                restartAutoPlay();
            };

            // Progress bar
            const updateProgress = () => {
                let progress = 0;
                const increment = (config.progressUpdateInterval / config.autoPlayDelay) * 100;

                clearInterval(state.progressInterval);
                elements.progressBar.style.width = '0%';

                state.progressInterval = setInterval(() => {
                    progress += increment;
                    if (progress >= 100) {
                        progress = 100;
                        clearInterval(state.progressInterval);
                    }
                    elements.progressBar.style.width = progress + '%';
                }, config.progressUpdateInterval);
            };

            const stopProgress = () => {
                clearInterval(state.progressInterval);
                elements.progressBar.style.width = '0%';
            };

            // AutoPlay management
            const startAutoPlay = () => {
                stopAutoPlay();
                // Don't start if video is playing
                if (state.isVideoPlaying) return;

                const totalItems = getTotalItems();
                if (totalItems > getItemsPerScreen() && !state.isAutoPlayPaused) {
                    updateProgress();
                    state.autoPlayInterval = setInterval(next, config.autoPlayDelay);
                }
            };

            const stopAutoPlay = () => {
                clearInterval(state.autoPlayInterval);
                stopProgress();
            };

            const restartAutoPlay = () => {
                stopAutoPlay();
                // Don't restart if video is playing
                if (state.isVideoPlaying) return;

                if (!state.isAutoPlayPaused) {
                    setTimeout(startAutoPlay, config.autoPlayResumeDelay);
                }
            };

            const pauseAutoPlay = () => {
                state.isAutoPlayPaused = true;
                stopAutoPlay();
            };

            const resumeAutoPlay = () => {
                // Critical Guard Clause: If video is playing, IGNORE resume attempts
                if (state.isVideoPlaying) return;

                state.isAutoPlayPaused = false;
                startAutoPlay();
            };

            // Touch/Swipe handling
            const handleTouchStart = (e) => {
                state.touchStart = {
                    x: e.changedTouches[0].screenX,
                    y: e.changedTouches[0].screenY,
                    time: Date.now()
                };
                
                // Initialize touchEnd to be same as touchStart to fix ghost swipes
                state.touchEnd = {
                    x: state.touchStart.x,
                    y: state.touchStart.y
                };
                
                pauseAutoPlay();
            };

            const handleTouchMove = (e) => {
                state.touchEnd = {
                    x: e.changedTouches[0].screenX,
                    y: e.changedTouches[0].screenY
                };

                const diffX = Math.abs(state.touchEnd.x - state.touchStart.x);
                const diffY = Math.abs(state.touchEnd.y - state.touchStart.y);

                if (diffX > diffY && diffX > 10) {
                    e.preventDefault();
                }
            };

            const handleTouchEnd = () => {
                const diffX = state.touchEnd.x - state.touchStart.x;
                const diffY = Math.abs(state.touchEnd.y - state.touchStart.y);
                const timeDiff = Date.now() - state.touchStart.time;

                if (Math.abs(diffX) > config.swipeThreshold &&
                    Math.abs(diffX) > diffY &&
                    timeDiff < 500) {

                    if (diffX < 0) {
                        isRTL() ? prev() : next();
                    } else {
                        isRTL() ? next() : prev();
                    }
                } else {
                    resumeAutoPlay();
                }
            };

            const handleKeyDown = (e) => {
                if (!elements.slider.matches(':hover') && document.activeElement !== elements.slider) return;

                if (e.key === 'ArrowLeft') {
                    e.preventDefault();
                    isRTL() ? next() : prev();
                } else if (e.key === 'ArrowRight') {
                    e.preventDefault();
                    isRTL() ? prev() : next();
                }
            };

            const handleResize = () => {
                clearTimeout(state.resizeTimeout);
                state.resizeTimeout = setTimeout(() => {
                    updateSlider(false);
                    createDots();
                    // Respect video playing state on resize
                    if (!state.isVideoPlaying) {
                        startAutoPlay();
                    }
                }, 150);
            };

            const lazyLoadImages = () => {
                const images = elements.slider.querySelectorAll('img[data-src]');
                if ('IntersectionObserver' in window) {
                    const imageObserver = new IntersectionObserver((entries, observer) => {
                        entries.forEach(entry => {
                            if (entry.isIntersecting) {
                                const img = entry.target;
                                img.src = img.dataset.src;
                                img.removeAttribute('data-src');
                                img.classList.remove('lazy-thumbnail');
                                observer.unobserve(img);
                            }
                        });
                    }, { rootMargin: '50px' });
                    images.forEach(img => imageObserver.observe(img));
                } else {
                    images.forEach(img => {
                        img.src = img.dataset.src;
                        img.classList.remove('lazy-thumbnail');
                    });
                }
            };

            // Play YouTube video
            const playYoutube = (el, url) => {
                // Lock the slider
                state.isVideoPlaying = true;
                stopAutoPlay(); 

                const iframe = document.createElement('iframe');
                iframe.src = `${url}?autoplay=1&rel=0&modestbranding=1`;
                iframe.className = 'w-full h-full';
                iframe.allow = 'autoplay; encrypted-media';
                iframe.allowFullscreen = true;
                iframe.frameBorder = '0';
                iframe.setAttribute('playsinline', '');

                el.innerHTML = '';
                el.appendChild(iframe);
            };

            const init = () => {
                if (!elements.slider || !elements.track) return;

                elements.slider.addEventListener('touchstart', handleTouchStart, { passive: true });
                elements.slider.addEventListener('touchmove', handleTouchMove, { passive: false });
                elements.slider.addEventListener('touchend', handleTouchEnd, { passive: true });
                elements.slider.addEventListener('mouseenter', pauseAutoPlay);
                elements.slider.addEventListener('mouseleave', resumeAutoPlay);
                document.addEventListener('keydown', handleKeyDown);
                window.addEventListener('resize', handleResize);

                elements.slider.setAttribute('tabindex', '0');

                lazyLoadImages();
                createDots();
                updateSlider(false);
                startAutoPlay();

                document.addEventListener('visibilitychange', () => {
                    if (document.hidden) {
                        pauseAutoPlay();
                    } else {
                        resumeAutoPlay();
                    }
                });
            };

            return {
                init,
                next,
                prev,
                goToSlide,
                playYoutube,
                pause: pauseAutoPlay,
                resume: resumeAutoPlay
            };
        })();

        document.addEventListener('DOMContentLoaded', testimonialSlider.init);
    </script>
}

<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">