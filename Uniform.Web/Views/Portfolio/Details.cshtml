@using UniformPro.Core.Helpers
@model UniformPro.Web.ViewModels.PortfolioDetailsViewModel
@{
    var isArabic = ViewData["IsArabic"] as bool? ?? false;
    ViewData["Title"] = Model.ClientName;
    ViewData["MetaDescription"] = Model.MetaDescription;
    ViewData["MetaKeywords"] = Model.MetaKeywords;
}

<div class="bg-gradient-to-b from-white to-gray-50 py-8 md:py-14 border-b">
    <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center">
            <span class="inline-block px-3 py-1 bg-primary/5 text-primary text-xs font-bold rounded-full mb-3 tracking-wide">
                @Model.CategoryName
            </span>
            <h1 class="text-3xl md:text-5xl font-bold text-gray-900 mb-3 font-outfit">
                @Model.ClientName
            </h1>
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="text-gray-600 text-base leading-relaxed whitespace-pre-line">
                    @Html.Raw(Model.Description)
                </div>
            }
        </div>
    </div>
</div>

<div class="bg-white py-12">
    <div class="container mx-auto px-4">
        
        @if (Model.GalleryImages.Any())
        {
            <div class="mb-16">
                <div class="columns-1 sm:columns-2 md:columns-3 gap-4">
                   @{ int i = 0; }
                   @foreach (var imgUrl in Model.GalleryImages)
                   {
                       <div class="break-inside-avoid mb-4 relative group cursor-zoom-in overflow-hidden rounded-xl shadow-sm hover:shadow-md transition-shadow" onclick="openLightbox(@i)">
                           
                           <img src="~/uploads/portfolios/media/@imgUrl" 
                                class="w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-500" 
                                loading="lazy"
                                alt="@Model.ClientName - صورة @(i+1)"> <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-300"></div>
                       </div>
                       i++;
                   }
                </div>
            </div>
        }

        @if (Model.VideoUrls.Any())
        {
            <div class="max-w-4xl mx-auto mb-16">
                <div class="flex items-center gap-3 mb-6 justify-center">
                    <span class="h-px w-8 bg-gray-200"></span>
                    <h2 class="text-xl font-bold text-gray-800">@(isArabic ? "فيديو المشروع" : "Project Video")</h2>
                    <span class="h-px w-8 bg-gray-200"></span>
                </div>
                
                <div class="@(Model.VideoUrls.Count == 1 ? "max-w-2xl mx-auto" : "grid grid-cols-1 md:grid-cols-2 gap-6")">
                    @foreach (var videoUrl in Model.VideoUrls)
                    {
                        <div class="aspect-video bg-black rounded-xl overflow-hidden shadow-lg relative border border-gray-100">
                             @if (videoUrl.Contains("youtube") || videoUrl.Contains("youtu.be"))
                             {
                                  <iframe src="@YoutubeHelper.GetEmbedUrl(videoUrl)" class="w-full h-full" frameborder="0" allowfullscreen></iframe>
                             }
                             else
                             {
                                  <video controls class="w-full h-full">
                                      <source src="~/uploads/portfolios/media/@videoUrl" type="video/mp4">
                                      Your browser does not support the video tag.
                                  </video>
                             }
                        </div>
                    }
                </div>
            </div>
        }

        @if (Model.ClientTestimonial != null)
        {
            <div class="max-w-4xl mx-auto">
                <div class="bg-gray-50 rounded-2xl shadow-sm border border-gray-100 p-8 md:p-10 relative overflow-hidden">
                    <div class="absolute top-0 right-0 p-4 opacity-5 pointer-events-none">
                        <i class="ph-fill ph-quotes text-8xl text-primary"></i>
                    </div>

                    <div class="relative z-10 flex flex-col md:flex-row items-center md:items-start gap-8">
                        
                        <div class="w-full md:w-1/3 flex-shrink-0">
                             @if (!string.IsNullOrEmpty(Model.ClientTestimonial.YoutubeUrl))
                             {
                                  <div class="aspect-video rounded-xl overflow-hidden shadow-lg bg-black border border-gray-200">
                                      <iframe src="@YoutubeHelper.GetEmbedUrl(Model.ClientTestimonial.YoutubeUrl)" class="w-full h-full" allowfullscreen></iframe>
                                  </div>
                             }
                             else if (!string.IsNullOrEmpty(Model.ClientTestimonial.VideoPath))
                             {
                                  <div class="aspect-[9/16] max-h-72 mx-auto md:mx-0 rounded-xl overflow-hidden shadow-lg bg-black border border-gray-200">
                                      <video controls class="w-full h-full object-cover">
                                          <source src="~/uploads/testimonials/videos/@Model.ClientTestimonial.VideoPath" type="video/mp4">
                                      </video>
                                  </div>
                             }
                             else if (!string.IsNullOrEmpty(Model.ClientTestimonial.ImagePath))
                             {
                                  <div class="aspect-square w-32 md:w-full max-w-[180px] mx-auto md:mx-0 rounded-full md:rounded-xl overflow-hidden shadow-md border-4 border-white">
                                      <img src="~/uploads/testimonials/images/@Model.ClientTestimonial.ImagePath" class="w-full h-full object-cover">
                                  </div>
                             }
                             else
                             {
                                  <div class="w-24 h-24 rounded-full bg-primary/10 flex items-center justify-center text-primary text-3xl mx-auto md:mx-0">
                                      <i class="ph-duotone ph-user"></i>
                                  </div>
                             }
                        </div>

                        <div class="flex-grow text-center md:text-right">
                             <div class="flex items-center justify-center md:justify-start gap-1 mb-3 text-orange-400 text-lg">
                                 <i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i><i class="ph-fill ph-star"></i>
                             </div>
                             
                             <blockquote class="text-xl font-medium text-gray-800 italic mb-6 leading-relaxed">
                                 " @Model.ClientTestimonial.Feedback "
                             </blockquote>

                             <div class="flex items-center justify-center md:justify-start gap-4">
                                 @if (!string.IsNullOrEmpty(Model.ClientTestimonial.ImagePath))
                                 {
                                     <img src="~/uploads/testimonials/images/@Model.ClientTestimonial.ImagePath" class="w-12 h-12 rounded-full border-2 border-white shadow-sm object-cover">
                                 }

                                 <div class="text-right">
                                     <div class="font-bold text-gray-900">@Model.ClientTestimonial.ClientName</div>
                                     @if (!string.IsNullOrEmpty(Model.ClientTestimonial.Position))
                                     {
                                         <div class="text-gray-500 text-xs">@Model.ClientTestimonial.Position</div>
                                     }
                                 </div>
                             </div>
                        </div>

                    </div>
                </div>
            </div>
        }

    </div>
</div>

<div id="lightbox" class="fixed inset-0 z-50 bg-black/95 hidden items-center justify-center backdrop-blur-sm transition-opacity duration-300 opacity-0" aria-hidden="true">
    
    <div id="lightbox-loader" class="absolute inset-0 flex items-center justify-center z-40 hidden">
        <svg class="animate-spin h-10 w-10 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
    </div>

    <button class="absolute top-4 right-4 text-white/50 hover:text-white p-2 z-[60] transition-colors" onclick="closeLightbox()">
        <i class="ph-bold ph-x text-3xl"></i>
    </button>
    
    <button class="absolute left-4 top-1/2 -translate-y-1/2 text-white/50 hover:text-white p-4 z-[60] transition-colors hidden md:block" onclick="prevImage()">
        <i class="ph-bold ph-caret-left text-4xl"></i>
    </button>

    <button class="absolute right-4 top-1/2 -translate-y-1/2 text-white/50 hover:text-white p-4 z-[60] transition-colors hidden md:block" onclick="nextImage()">
        <i class="ph-bold ph-caret-right text-4xl"></i>
    </button>
    
    <div class="relative w-full h-full flex items-center justify-center p-4" onclick="if(event.target === this) closeLightbox()">
        <img id="lightbox-img" src="" class="max-w-full max-h-full object-contain shadow-2xl rounded-sm transform scale-95 transition-all duration-300 opacity-0">
    </div>

</div>

@section Scripts {
    <script>
        // تعديل 4: استخدام JSON Serialize للأمان والسرعة
        const galleryImages = @Json.Serialize(Model.GalleryImages);

        let currentIndex = 0;
        const lightbox = document.getElementById('lightbox');
        const img = document.getElementById('lightbox-img');
        const loader = document.getElementById('lightbox-loader'); // الـ Loader

        function openLightbox(index) {
            if (index < 0 || index >= galleryImages.length) return;
            
            currentIndex = index;
            
            // Show Modal
            lightbox.classList.remove('hidden', 'pointer-events-none');
            void lightbox.offsetWidth; // Reflow
            lightbox.classList.remove('opacity-0');
            lightbox.classList.add('flex');
            lightbox.setAttribute('aria-hidden', 'false');
            
            document.body.style.overflow = 'hidden'; 

            updateImage();
        }

        function closeLightbox() {
            lightbox.classList.add('opacity-0');
            img.classList.remove('scale-100');
            img.classList.add('scale-95');
            
            setTimeout(() => {
                lightbox.classList.add('hidden');
                lightbox.classList.remove('flex');
                lightbox.setAttribute('aria-hidden', 'true');
                document.body.style.overflow = 'auto';
                
                // Reset image source to avoid flickering next time
                img.src = "";
            }, 300);
        }

        function nextImage() {
            if (galleryImages.length <= 1) return;
            currentIndex = (currentIndex + 1) % galleryImages.length;
            updateImage();
        }

        function prevImage() {
            if (galleryImages.length <= 1) return;
            currentIndex = (currentIndex - 1 + galleryImages.length) % galleryImages.length;
            updateImage();
        }

        function updateImage() {
            const imgSrc = '/uploads/portfolios/media/' + galleryImages[currentIndex];
            
            // 1. Show Loader & Hide Image
            loader.classList.remove('hidden');
            img.classList.add('opacity-0', 'scale-95');
            img.classList.remove('scale-100');

            // 2. Set Source
            img.src = imgSrc;

            // 3. When Loaded -> Show Image & Hide Loader
            img.onload = function() {
                loader.classList.add('hidden');
                img.classList.remove('opacity-0', 'scale-95');
                img.classList.add('scale-100');
            };
        }

        document.addEventListener('keydown', function(e) {
            if (lightbox.classList.contains('hidden')) return;

            if (e.key === 'Escape') closeLightbox();
            if (e.key === 'ArrowRight' || e.key === 'ArrowUp') nextImage(); 
            if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') prevImage();
        });
    </script>
}